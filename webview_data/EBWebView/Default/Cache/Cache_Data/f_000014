                isLoFiPlaying = false;
                document.getElementById('lofiIcon').classList.replace('fa-volume-high', 'fa-music');
                showToast('Focus Music Paused'); return;
            }
            try {
                if (!loFiAudioCtx) loFiAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const bufferSize = loFiAudioCtx.sampleRate * 2;
                const buffer = loFiAudioCtx.createBuffer(1, bufferSize, loFiAudioCtx.sampleRate);
                const output = buffer.getChannelData(0);
                let lastOut = 0;
                for (let i = 0; i < bufferSize; i++) {
                    const white = Math.random() * 2 - 1;
                    output[i] = (lastOut + (0.02 * white)) / 1.02;
                    lastOut = output[i]; output[i] *= 3.5;
                }
                loFiNoise = loFiAudioCtx.createBufferSource();
                loFiNoise.buffer = buffer; loFiNoise.loop = true;
                const gainNode = loFiAudioCtx.createGain();
                gainNode.gain.value = 0.05;
                loFiNoise.connect(gainNode); gainNode.connect(loFiAudioCtx.destination);
                loFiNoise.start(); isLoFiPlaying = true;
                document.getElementById('lofiIcon').classList.replace('fa-music', 'fa-volume-high');
                showToast('Focus Music Playing 🎵');
            } catch(e) { showToast('Audio not supported', true); }

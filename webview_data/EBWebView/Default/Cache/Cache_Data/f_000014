        function resetZenIdleTimer() {
            document.body.classList.remove('zen-idle');
            clearTimeout(zenIdleTimer);
            if (document.body.classList.contains('zen-mode')) {
                zenIdleTimer = setTimeout(() => {
                    const mixerOpen = !document.getElementById('soundMixerDrawer').classList.contains('hidden');
                    if (document.body.classList.contains('zen-mode') && !mixerOpen) {
                        document.body.classList.add('zen-idle');
                    }
                }, 3500);
            }
        }

        async function toggleZenMode() {
            const entering = !document.body.classList.contains('zen-mode');
            document.body.classList.toggle('zen-mode', entering);
            const icon = document.getElementById('zenIcon');
            const topBar = document.getElementById('zenTopBar');
            const subView = document.getElementById('subjectView');

            if (entering) {
                if (icon) { icon.className = 'fa-solid fa-compress text-amber-400'; }
                if (topBar) { topBar.classList.remove('hidden'); topBar.classList.add('flex'); }
                subView.classList.remove('zen-workspace-visible');
                const btnTxt = document.getElementById('zenWorkspaceToggleText');
                if (btnTxt) btnTxt.textContent = 'Show Study View';
                document.getElementById('zenCenterOverlay')?.classList.remove('hidden');

                await refreshZenVideosList(false);
                applyZenBackdropSource();
                resetZenIdleTimer();
                showToast('Zen Tea Sanctuary Activated 🏮 (Guests arriving in order • Esc to exit)');
            } else {
                if (icon) { icon.className = 'fa-solid fa-spa'; }
                if (topBar) { topBar.classList.add('hidden'); topBar.classList.remove('flex'); }
                document.body.classList.remove('zen-idle');
                clearTimeout(zenIdleTimer);
                stopZenAmbientCanvas();
                const vidEl = document.getElementById('zenBackdropVideo');
                if (vidEl) vidEl.pause();
                subView.classList.remove('zen-workspace-visible');
                showToast('Zen Mode Deactivated');
            }
        }


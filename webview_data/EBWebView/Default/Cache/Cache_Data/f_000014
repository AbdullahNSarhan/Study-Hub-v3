        function toggleZenWorkspaceOverlay() {
            if (!state.currentSubjectId && state.subjects.length > 0) {
                openSubject(state.subjects[0].id);
            } else if (!state.currentSubjectId) {
                return showToast('Create or open a subject first to view study materials in Zen Mode!', true);
            }
            const subView = document.getElementById('subjectView');
            const btnTxt = document.getElementById('zenWorkspaceToggleText');
            const centerBadge = document.getElementById('zenCenterOverlay');
            const isShowing = subView.classList.toggle('zen-workspace-visible');
            if (btnTxt) btnTxt.textContent = isShowing ? 'Hide Study View' : 'Show Study View';
            if (centerBadge) centerBadge.classList.toggle('hidden', isShowing);

        async function uploadFilesToFolder(files, targetFolder) {
            if (!files || files.length === 0) return;
            showToast(`Uploading ${files.length} file(s) to ${targetFolder}... ⏳`);
            const fd = new FormData();
            for (let i = 0; i < files.length; i++) fd.append('files[]', files[i]);
            fd.append('subject_id', state.currentSubjectId);
            fd.append('folder', targetFolder);

            try {
                const res = await fetch(`${API_URL}/upload_file`, { method: 'POST', body: fd });
                const result = await res.json();
                if (result.status === 'success' && result.files) {
                    result.files.forEach(f => {
                        state.pdfs.push({ id: 'file_' + Date.now() + Math.random(), subjectId: state.currentSubjectId, original_name: f.original_name, filename: f.filename, folder: f.folder });
                    });
                    expandedFolders.add(targetFolder);
                    saveData(); renderFiles(); updateSubjectStats(state.currentSubjectId);
                    showToast(`${result.files.length} file(s) uploaded to ${targetFolder}! ✅`);
                    if (result.skipped && result.skipped.length) showToast(`Skipped unsupported: ${result.skipped.join(', ')}`, true);
                } else { showToast(result.error || 'Upload failed', true); }

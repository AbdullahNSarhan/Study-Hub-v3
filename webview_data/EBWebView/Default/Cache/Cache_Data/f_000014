            showToast(`Sanctuary Mood: ${scene.name} ✨`);
        }

        function startZenAmbientCanvas() {
            const c = document.getElementById('zenAmbientCanvas');
            if (!c) return;
            initZenSanctuarySimulation();
            const ctx = c.getContext('2d');
            const resize = () => { c.width = window.innerWidth; c.height = window.innerHeight; };
            resize();

            if (!c._zenClickBound) {
                c._zenClickBound = true;
                c.addEventListener('click', (e) => {
                    zenRipples.push({ x: e.clientX, y: e.clientY, r: 2, maxR: 38, alpha: 0.65 });
                    spawnZenSanctuaryGuest(false, false);
                });
            }

            if (!zenParticles.length) {
                for (let i = 0; i < 55; i++) {
                    zenParticles.push({
                        x: Math.random() * window.innerWidth,
                        y: Math.random() * window.innerHeight,
                        r: Math.random() * 2.2 + 0.9,
                        vx: (Math.random() - 0.5) * 0.4,
                        vy: -Math.random() * 0.45 - 0.1,
                        phase: Math.random() * Math.PI * 2,
                        sakura: i < 16
                    });
                }
            }

            if (zenAnimFrame) cancelAnimationFrame(zenAnimFrame);
            let t = 0;

            function drawZenFrame() {
                if (!document.body.classList.contains('zen-mode') || zenUsingCustomVideo) return;
                if (document.body.classList.contains('perf-throttled') && (t % 3 !== 0)) {
                    t++; zenAnimFrame = requestAnimationFrame(drawZenFrame); return;
                }
                t += 0.02;
                updateZenSanctuarySimulation();

                const w = c.width, h = c.height;
                const scene = ZEN_BUILTIN_SCENES[zenBuiltinSceneIdx] || ZEN_BUILTIN_SCENES[0];
                const isNight = scene.id === 'aurora_night';
                const isRain = scene.id === 'rain_garden';

                // 1. Background room void
                const bgGrad = ctx.createRadialGradient(w * 0.5, h * 0.45, 50, w * 0.5, h * 0.5, Math.max(w, h) * 0.75);
                if (isNight) {
                    bgGrad.addColorStop(0, '#1a162b');
                    bgGrad.addColorStop(1, '#090712');
                } else if (isRain) {
                    bgGrad.addColorStop(0, '#1f1918');
                    bgGrad.addColorStop(1, '#0c0908');
                } else {
                    bgGrad.addColorStop(0, '#261810');
                    bgGrad.addColorStop(1, '#0f0906');
                }
                ctx.fillStyle = bgGrad;
                ctx.fillRect(0, 0, w, h);

                // Isometric Projection Setup (16x16 grid)
                const GRID = 16;
                const tileW = Math.min(w / 17.5, h / 10.2);
                const tileH = tileW * 0.5;
                const originX = w * 0.5;
                const originY = h * 0.5 - (GRID * tileH * 0.42);

                const isoPt = (gx, gy, gz = 0) => ({
                    x: originX + (gx - gy) * (tileW * 0.5),
                    y: originY + (gx + gy) * (tileH * 0.5) - gz * (tileH * 1.15)
                });

                const fillIsoQuad = (gx1, gy1, gx2, gy2, gz, fillStyle, strokeStyle = null) => {
                    const p1 = isoPt(gx1, gy1, gz);
                    const p2 = isoPt(gx2, gy1, gz);
                    const p3 = isoPt(gx2, gy2, gz);
                    const p4 = isoPt(gx1, gy2, gz);
                    ctx.beginPath();
                    ctx.moveTo(p1.x, p1.y);
                    ctx.lineTo(p2.x, p2.y);
                    ctx.lineTo(p3.x, p3.y);
                    ctx.lineTo(p4.x, p4.y);
                    ctx.closePath();
                    if (fillStyle) { ctx.fillStyle = fillStyle; ctx.fill(); }
                    if (strokeStyle) { ctx.strokeStyle = strokeStyle; ctx.lineWidth = 1; ctx.stroke(); }
                };

                const drawIsoBox = (gx1, gy1, gx2, gy2, gz0, gz1, topCol, leftCol, rightCol) => {
                    const b1 = isoPt(gx1, gy1, gz0), b2 = isoPt(gx2, gy1, gz0), b3 = isoPt(gx2, gy2, gz0), b4 = isoPt(gx1, gy2, gz0);
                    const t1 = isoPt(gx1, gy1, gz1), t2 = isoPt(gx2, gy1, gz1), t3 = isoPt(gx2, gy2, gz1), t4 = isoPt(gx1, gy2, gz1);
                    // Left-front face (gx1..gx2 at gy2)
                    ctx.fillStyle = leftCol;
                    ctx.beginPath(); ctx.moveTo(t4.x, t4.y); ctx.lineTo(t3.x, t3.y); ctx.lineTo(b3.x, b3.y); ctx.lineTo(b4.x, b4.y); ctx.closePath(); ctx.fill();
                    // Right-front face (gx2 at gy1..gy2)
                    ctx.fillStyle = rightCol;
                    ctx.beginPath(); ctx.moveTo(t2.x, t2.y); ctx.lineTo(t3.x, t3.y); ctx.lineTo(b3.x, b3.y); ctx.lineTo(b2.x, b2.y); ctx.closePath(); ctx.fill();
                    // Top face
                    ctx.fillStyle = topCol;
                    ctx.beginPath(); ctx.moveTo(t1.x, t1.y); ctx.lineTo(t2.x, t2.y); ctx.lineTo(t3.x, t3.y); ctx.lineTo(t4.x, t4.y); ctx.closePath(); ctx.fill();
                };

                // 2. Cedar Wood Floor Base & Plank Grid
                const floorShadow = isoPt(GRID * 0.5, GRID * 0.5, -0.35);
                fillIsoQuad(0, 0, GRID, GRID, -0.25, '#1a0f0a');
                const woodFill = isNight ? '#3d2822' : '#5c3824';
                fillIsoQuad(0, 0, GRID, GRID, 0, woodFill, 'rgba(255,200,140,0.08)');

                // Subtle plank lines across the cedar floor
                ctx.strokeStyle = 'rgba(25, 12, 6, 0.26)';
                ctx.lineWidth = 1;
                for (let i = 1; i < GRID; i++) {
                    const a = isoPt(i, 0, 0), b = isoPt(i, GRID, 0);
                    ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
                    const c1 = isoPt(0, i, 0), c2 = isoPt(GRID, i, 0);
                    ctx.beginPath(); ctx.moveTo(c1.x, c1.y); ctx.lineTo(c2.x, c2.y); ctx.stroke();
                }

                // 3. Stone Walkway Channels & Outer Water Channels (matching reference screenshot)
                const slateCol = isNight ? '#2c3540' : '#4a4e54';
                fillIsoQuad(3.3, 3.3, 4.3, 12.6, 0.01, slateCol);
                fillIsoQuad(3.3, 11.7, 12.6, 12.6, 0.01, slateCol);
                fillIsoQuad(11.7, 3.3, 12.6, 12.6, 0.01, slateCol);
                fillIsoQuad(3.3, 3.3, 12.6, 4.2, 0.01, slateCol);

                // Shallow reflective stone channels on far left & right wings
                fillIsoQuad(2.7, 1.2, 3.3, 7.6, 0.01, '#575c62');
                fillIsoQuad(12.6, 5.8, 13.2, 12.6, 0.01, '#575c62');

                // 4. Central Sanctuary Pond & 2 Illuminated Turquoise Koi Channels
                // Central Pond (gx 6.0..9.0, gy 6.0..9.0)
                fillIsoQuad(6.0, 6.0, 9.0, 9.0, 0.02, '#2d3b3e', '#3e2723');
                // Central island moss rock
                fillIsoQuad(7.1, 7.1, 7.9, 7.9, 0.06, '#365314');

                // Turquoise Koi Pond 1 (gx 6.0..9.0, gy 10.05..10.75)
                const aquaGrad1 = isNight ? '#155e75' : '#38bdf8';
                drawIsoBox(5.95, 10.0, 9.05, 10.8, 0, 0.14, aquaGrad1, '#334155', '#1e293b');
                // Turquoise Koi Pond 2 (gx 10.05..10.75, gy 6.0..9.0)
                drawIsoBox(10.0, 5.95, 10.8, 9.05, 0, 0.14, aquaGrad1, '#334155', '#1e293b');

                // Draw Swimming Koi Fish inside the ponds
                zenSimKoi.forEach(k => {
                    const kp = isoPt(k.gx, k.gy, 0.15);
                    const wag = Math.sin(k.phase) * 0.28;
                    ctx.save();
                    ctx.translate(kp.x, kp.y);
                    // Project grid velocity angle to screen angle
                    const dirPt = isoPt(k.gx + Math.cos(k.angle), k.gy + Math.sin(k.angle), 0.15);
                    const scrAng = Math.atan2(dirPt.y - kp.y, dirPt.x - kp.x);
                    ctx.rotate(scrAng);
                    // Koi body
                    ctx.fillStyle = k.color;
                    ctx.beginPath();
                    ctx.ellipse(0, 0, tileW * 0.13, tileW * 0.05, 0, 0, Math.PI * 2);
                    ctx.fill();
                    // Koi spot
                    ctx.fillStyle = k.spots;
                    ctx.beginPath();
                    ctx.arc(tileW * 0.02, 0, tileW * 0.035, 0, Math.PI * 2);
                    ctx.fill();
                    // Wagging tail fin
                    ctx.fillStyle = k.color;
                    ctx.beginPath();
                    ctx.moveTo(-tileW * 0.11, 0);
                    ctx.lineTo(-tileW * 0.21, -tileW * 0.05 + wag * 6);
                    ctx.lineTo(-tileW * 0.21, tileW * 0.05 + wag * 6);
                    ctx.closePath();
                    ctx.fill();
                    ctx.restore();
                });

                // Floating water lanterns & lotus pads on the central pond
                const waterLanterns = [[6.6, 6.7], [8.3, 6.6], [6.7, 8.3], [8.4, 8.2], [7.5, 6.4], [6.4, 7.5]];
                waterLanterns.forEach(([wx, wy], idx) => {
                    const wp = isoPt(wx, wy, 0.05);
                    const pulse = 0.8 + 0.2 * Math.sin(t * 2.5 + idx);
                    const g = ctx.createRadialGradient(wp.x, wp.y, 1, wp.x, wp.y, tileW * 0.24 * pulse);
                    g.addColorStop(0, 'rgba(254, 240, 138, 0.95)');
                    g.addColorStop(0.4, 'rgba(251, 146, 60, 0.45)');
                    g.addColorStop(1, 'rgba(0,0,0,0)');
                    ctx.fillStyle = g;
                    ctx.beginPath(); ctx.arc(wp.x, wp.y, tileW * 0.24 * pulse, 0, Math.PI * 2); ctx.fill();
                });

                // Central Pond Wooden Railing Fence
                ctx.strokeStyle = '#3e2214';
                ctx.lineWidth = 2;
                const fCorners = [isoPt(6.0, 6.0, 0.25), isoPt(9.0, 6.0, 0.25), isoPt(9.0, 9.0, 0.25), isoPt(6.0, 9.0, 0.25)];
                ctx.beginPath();
                ctx.moveTo(fCorners[0].x, fCorners[0].y);
                fCorners.forEach(p => ctx.lineTo(p.x, p.y));
                ctx.closePath();
                ctx.stroke();

                // 5. Back Left Wall (gx = 0, gy = 0..16) & Back Right Wall (gy = 0, gx = 0..16)
                const WALL_H = 3.2;
                const drawWallSegment = (isLeftWall) => {
                    const pB1 = isLeftWall ? isoPt(0, 0, 0) : isoPt(0, 0, 0);
                    const pB2 = isLeftWall ? isoPt(0, GRID, 0) : isoPt(GRID, 0, 0);
                    const pT2 = isLeftWall ? isoPt(0, GRID, WALL_H) : isoPt(GRID, 0, WALL_H);
                    const pT1 = isLeftWall ? isoPt(0, 0, WALL_H) : isoPt(0, 0, WALL_H);

                    // Dark wood wall base & plaster upper
                    ctx.fillStyle = isLeftWall ? '#2d1c12' : '#24160e';
                    ctx.beginPath();
                    ctx.moveTo(pB1.x, pB1.y); ctx.lineTo(pB2.x, pB2.y);
                    ctx.lineTo(pT2.x, pT2.y); ctx.lineTo(pT1.x, pT1.y);
                    ctx.closePath();
                    ctx.fill();

                    // Shoji cream wall panels
                    for (let i = 0; i < GRID; i += 2) {
                        const sB1 = isLeftWall ? isoPt(0, i + 0.1, 0.8) : isoPt(i + 0.1, 0, 0.8);
                        const sB2 = isLeftWall ? isoPt(0, i + 1.9, 0.8) : isoPt(i + 1.9, 0, 0.8);
                        const sT2 = isLeftWall ? isoPt(0, i + 1.9, WALL_H - 0.35) : isoPt(i + 1.9, 0, WALL_H - 0.35);
                        const sT1 = isLeftWall ? isoPt(0, i + 0.1, WALL_H - 0.35) : isoPt(i + 0.1, 0, WALL_H - 0.35);
                        ctx.fillStyle = isNight ? 'rgba(180, 175, 190, 0.55)' : 'rgba(235, 218, 195, 0.72)';
                        ctx.beginPath();
                        ctx.moveTo(sB1.x, sB1.y); ctx.lineTo(sB2.x, sB2.y);
                        ctx.lineTo(sT2.x, sT2.y); ctx.lineTo(sT1.x, sT1.y);
                        ctx.closePath();
                        ctx.fill();
                    }

                    // Glowing Circular Shoji Windows
                    const winPositions = isLeftWall ? [2.2, 6.6, 10.8, 14.4] : [2.4, 10.6, 14.2];
                    winPositions.forEach((pos, idx) => {
                        const wc = isLeftWall ? isoPt(0, pos, 1.85) : isoPt(pos, 0, 1.85);
                        const pulse = 0.88 + 0.12 * Math.sin(t * 1.5 + idx);
                        const rx = tileW * 0.36;
                        const ry = tileW * 0.42;

                        // Warm window halo
                        const halo = ctx.createRadialGradient(wc.x, wc.y, 2, wc.x, wc.y, rx * 2.4);
                        if (isNight) {
                            halo.addColorStop(0, `rgba(165, 243, 252, ${0.45 * pulse})`);
                            halo.addColorStop(1, 'rgba(0,0,0,0)');
                        } else {
                            halo.addColorStop(0, `rgba(255, 215, 130, ${0.55 * pulse})`);
                            halo.addColorStop(1, 'rgba(0,0,0,0)');
                        }
                        ctx.fillStyle = halo;
                        ctx.beginPath(); ctx.arc(wc.x, wc.y, rx * 2.4, 0, Math.PI * 2); ctx.fill();

                        // Window circle
                        ctx.save();
                        ctx.translate(wc.x, wc.y);
                        ctx.transform(1, isLeftWall ? 0.45 : -0.45, 0, 1, 0, 0);
                        ctx.fillStyle = isNight ? '#bae6fd' : '#fde68a';
                        ctx.strokeStyle = '#3e2214';
                        ctx.lineWidth = 2.5;
                        ctx.beginPath();
                        ctx.arc(0, 0, rx * 0.72, 0, Math.PI * 2);
                        ctx.fill();
                        ctx.stroke();
                        // Shoji lattice crossbars inside circular window
                        ctx.lineWidth = 1.2;
                        ctx.beginPath();
                        ctx.moveTo(-rx * 0.68, -rx * 0.22); ctx.lineTo(rx * 0.68, -rx * 0.22);
                        ctx.moveTo(-rx * 0.68, rx * 0.22); ctx.lineTo(rx * 0.68, rx * 0.22);
                        ctx.moveTo(-rx * 0.22, -rx * 0.68); ctx.lineTo(-rx * 0.22, rx * 0.68);
                        ctx.moveTo(rx * 0.22, -rx * 0.68); ctx.lineTo(rx * 0.22, rx * 0.68);
                        ctx.stroke();
                        ctx.restore();

                        // Floor light pool cast from window
                        const fp = isLeftWall ? isoPt(1.5, pos, 0.02) : isoPt(pos, 1.5, 0.02);
                        const fg = ctx.createRadialGradient(fp.x, fp.y, 2, fp.x, fp.y, tileW * 0.95);
                        fg.addColorStop(0, isNight ? 'rgba(125, 211, 252, 0.10)' : 'rgba(253, 224, 71, 0.14)');
                        fg.addColorStop(1, 'rgba(0,0,0,0)');
                        ctx.fillStyle = fg;
                        ctx.beginPath(); ctx.arc(fp.x, fp.y, tileW * 0.95, 0, Math.PI * 2); ctx.fill();
                    });

                    // Twinkling Fairy Lights Garland along top cornice of wall
                    for (let f = 0.3; f < GRID - 0.2; f += 0.45) {
                        const sag = Math.sin(f * 2.2) * 0.08;
                        const fp = isLeftWall ? isoPt(0, f, WALL_H - 0.18 + sag) : isoPt(f, 0, WALL_H - 0.18 + sag);
                        const blink = 0.55 + 0.45 * Math.sin(t * 3.5 + f * 4.1);
                        ctx.fillStyle = `rgba(254, 243, 199, ${blink})`;
                        ctx.beginPath();
                        ctx.arc(fp.x, fp.y, 1.9, 0, Math.PI * 2);
                        ctx.fill();
                    }
                };

                drawWallSegment(true);
                drawWallSegment(false);

                // Entrance / Exit Doorway with Noren Curtains on Left Wall (gy = 3.7..4.7)
                const dB1 = isoPt(0.02, 3.75, 0), dB2 = isoPt(0.02, 4.65, 0);
                const dT2 = isoPt(0.02, 4.65, 2.35), dT1 = isoPt(0.02, 3.75, 2.35);
                ctx.fillStyle = '#120905';
                ctx.beginPath(); ctx.moveTo(dB1.x, dB1.y); ctx.lineTo(dB2.x, dB2.y); ctx.lineTo(dT2.x, dT2.y); ctx.lineTo(dT1.x, dT1.y); ctx.closePath(); ctx.fill();
                // Warm interior doorway glow
                const doorCenter = isoPt(0.02, 4.2, 1.1);
                const dg = ctx.createRadialGradient(doorCenter.x, doorCenter.y, 2, doorCenter.x, doorCenter.y, tileW * 0.75);
                dg.addColorStop(0, 'rgba(251, 191, 36, 0.38)');
                dg.addColorStop(1, 'rgba(0,0,0,0)');
                ctx.fillStyle = dg;
                ctx.beginPath(); ctx.arc(doorCenter.x, doorCenter.y, tileW * 0.75, 0, Math.PI * 2); ctx.fill();
                // Noren Hanging Curtain Panels (sways when guests enter/leave)
                const swayOff = Math.sin(t * 6) * zenDoorCurtainSway * 5;
                for (let panel = 0; panel < 3; panel++) {
                    const py1 = 3.78 + panel * 0.28;
                    const py2 = py1 + 0.24;
                    const nT1 = isoPt(0.05, py1, 2.32), nT2 = isoPt(0.05, py2, 2.32);
                    const nB2 = isoPt(0.05, py2, 1.25), nB1 = isoPt(0.05, py1, 1.25);
                    ctx.fillStyle = '#7c2d12';
                    ctx.beginPath();
                    ctx.moveTo(nT1.x, nT1.y); ctx.lineTo(nT2.x, nT2.y);
                    ctx.lineTo(nB2.x + swayOff, nB2.y); ctx.lineTo(nB1.x + swayOff, nB1.y);
                    ctx.closePath();
                    ctx.fill();
                }

                // Upper-Right Tea Kitchen & Counter Area (gx = 4.5..7.5, gy = 0..1.4)
                // Kitchen Chef / Tea Master NPC behind counter
                const chefPt = isoPt(5.9, 0.75, 0);
                const chefBob = Math.sin(t * 3.2) * 1.5;
                ctx.fillStyle = '#f8fafc';
                ctx.beginPath(); ctx.arc(chefPt.x, chefPt.y - tileH * 1.15 + chefBob, tileW * 0.09, 0, Math.PI * 2); ctx.fill();
                ctx.fillStyle = '#1e293b';
                ctx.fillRect(chefPt.x - tileW * 0.08, chefPt.y - tileH * 0.95 + chefBob, tileW * 0.16, tileH * 0.55);
                // Counter Box
                drawIsoBox(4.5, 0.95, 7.3, 1.45, 0, 0.85, '#854d0e', '#5c3409', '#452606');
                // Overhead kitchen sign & hanging warm lamps
                [5.0, 5.9, 6.8].forEach((kx, idx) => {
                    const lp = isoPt(kx, 1.1, 2.1);
                    const lg = ctx.createRadialGradient(lp.x, lp.y, 1, lp.x, lp.y, tileW * 0.45);
                    lg.addColorStop(0, 'rgba(254, 240, 138, 0.95)');
                    lg.addColorStop(0.4, 'rgba(245, 158, 11, 0.38)');
                    lg.addColorStop(1, 'rgba(0,0,0,0)');
                    ctx.fillStyle = lg;
                    ctx.beginPath(); ctx.arc(lp.x, lp.y, tileW * 0.45, 0, Math.PI * 2); ctx.fill();
                });

                // 6. Depth-Sorted 3D Entities (Tables, Chairs, Bonsai Trees, Bamboo Stalks, Lanterns, Guests & Waiters)
                const renderQueue = [];

                // Potted Pink Sakura Bonsai Trees
                [[3.15, 5.3], [5.3, 3.15]].forEach(([bx, by]) => {
                    renderQueue.push({
                        depth: bx + by,
                        draw: () => {
                            drawIsoBox(bx - 0.35, by - 0.35, bx + 0.35, by + 0.35, 0, 0.22, '#64748b', '#475569', '#334155');
                            const bp = isoPt(bx, by, 0.22);
                            // Trunk
                            ctx.strokeStyle = '#451a03';
                            ctx.lineWidth = 3.5;
                            ctx.beginPath();
                            ctx.moveTo(bp.x, bp.y);
                            ctx.quadraticCurveTo(bp.x - 5, bp.y - tileH * 0.7, bp.x + 2, bp.y - tileH * 1.25);
                            ctx.stroke();
                            // Sakura pink canopy puffs
                            const puffs = [[0, -1.35, 0.32], [-0.22, -1.15, 0.24], [0.24, -1.2, 0.25], [0, -1.55, 0.24]];
                            puffs.forEach(([ox, oy, rad], idx) => {
                                ctx.fillStyle = idx % 2 === 0 ? '#f472b6' : '#fbcfe8';
                                ctx.beginPath();
                                ctx.arc(bp.x + ox * tileW, bp.y + oy * tileH, rad * tileW, 0, Math.PI * 2);
                                ctx.fill();
                            });
                        }
                    });
                });

                // Tables & Seats
                zenSimTables.forEach(tb => {
                    renderQueue.push({
                        depth: tb.gx + tb.gy,
                        draw: () => {
                            const hw = tb.w * 0.5, hh = tb.h * 0.5;
                            // Table shadow
                            fillIsoQuad(tb.gx - hw, tb.gy - hh, tb.gx + hw, tb.gy + hh, 0.02, 'rgba(0,0,0,0.35)');
                            // Table pedestal / legs & tabletop
                            drawIsoBox(tb.gx - hw * 0.4, tb.gy - hh * 0.4, tb.gx + hw * 0.4, tb.gy + hh * 0.4, 0, 0.52, '#3e2214', '#2d180e', '#1f1009');
                            drawIsoBox(tb.gx - hw, tb.gy - hh, tb.gx + hw, tb.gy + hh, 0.52, 0.64, '#9a5b25', '#784419', '#5c3311');
                            // Tiny warm table candle/placemat
                            const tp = isoPt(tb.gx, tb.gy, 0.65);
                            ctx.fillStyle = '#fde68a';
                            ctx.beginPath(); ctx.arc(tp.x, tp.y, 2.2, 0, Math.PI * 2); ctx.fill();
                        }
                    });
                });

                // Chairs / Stools
                zenSimSeats.forEach(st => {
                    renderQueue.push({
                        depth: st.gx + st.gy - 0.05,
                        draw: () => {
                            drawIsoBox(st.gx - 0.18, st.gy - 0.18, st.gx + 0.18, st.gy + 0.18, 0, 0.34, '#e2e8f0', '#94a3b8', '#64748b');
                        }
                    });
                });

                // Glowing Shoji Floor Lanterns
                zenSimLanterns.forEach(ln => {
                    renderQueue.push({
                        depth: ln.gx + ln.gy,
                        draw: () => {
                            const lp = isoPt(ln.gx, ln.gy, 0.45);
                            const pulse = 0.82 + 0.18 * Math.sin(t * 2.2 + ln.phase);
                            // Floor glow halo
                            const fg = ctx.createRadialGradient(lp.x, lp.y + tileH * 0.3, 2, lp.x, lp.y + tileH * 0.3, tileW * 0.85 * pulse);
                            if (isNight) {
                                fg.addColorStop(0, `rgba(165, 243, 252, ${0.38 * pulse})`);
                                fg.addColorStop(0.5, `rgba(124, 92, 255, ${0.14 * pulse})`);
                            } else {
                                fg.addColorStop(0, `rgba(255, 214, 120, ${0.46 * pulse})`);
                                fg.addColorStop(0.5, `rgba(249, 115, 22, ${0.16 * pulse})`);
                            }
                            fg.addColorStop(1, 'rgba(0,0,0,0)');
                            ctx.fillStyle = fg;
                            ctx.beginPath(); ctx.arc(lp.x, lp.y + tileH * 0.3, tileW * 0.85 * pulse, 0, Math.PI * 2); ctx.fill();

                            // Lantern body
                            drawIsoBox(ln.gx - 0.16, ln.gy - 0.16, ln.gx + 0.16, ln.gy + 0.16, 0, 0.82, '#29170e', '#fffbeb', '#fde68a');
                        }
                    });
                });

                // Bamboo Stalk Partitions
                zenSimBamboos.forEach(bm => {
                    renderQueue.push({
                        depth: bm.gx + bm.gy,
                        draw: () => {
                            const bp = isoPt(bm.gx, bm.gy, 0);
                            const sway = Math.sin(t * 1.6 + bm.seed) * 1.4;
                            const offsets = [-0.08, 0, 0.08];
                            offsets.forEach((ox, idx) => {
                                const sx = bp.x + ox * tileW;
                                const sy = bp.y + (idx - 1) * 1.5;
                                const hPx = tileH * (1.75 + (idx % 2) * 0.25);
                                ctx.strokeStyle = idx === 1 ? '#4d7c0f' : '#3f6212';
                                ctx.lineWidth = Math.max(2, tileW * 0.045);
                                ctx.beginPath();
                                ctx.moveTo(sx, sy);
                                ctx.lineTo(sx + sway, sy - hPx);
                                ctx.stroke();
                                // Bamboo leaf tuft
                                ctx.fillStyle = '#65a30d';
                                ctx.beginPath();
                                ctx.ellipse(sx + sway + 3, sy - hPx + 3, 4, 1.8, 0.4, 0, Math.PI * 2);
                                ctx.fill();
                            });
                        }
                    });
                });

                // Helper to draw an Isometric Character (Guest or Waiter)
                const drawCharacter = (actor, isWaiter) => {
                    const isWalking = (actor.waypoints && actor.waypoints.length > 0);
                    const bob = isWalking ? Math.abs(Math.sin(actor.walkPhase)) * 3.2 : Math.sin(t * 2 + actor.id) * 0.8;
                    const baseZ = (!isWaiter && (actor.state === 'ORDERING' || actor.state === 'WAITING_FOOD' || actor.state === 'ENJOYING')) ? 0.18 : 0;
                    const p = isoPt(actor.gx, actor.gy, baseZ);

                    // Ground shadow
                    ctx.fillStyle = 'rgba(0,0,0,0.38)';
                    ctx.beginPath();
                    ctx.ellipse(p.x, p.y + 2, tileW * 0.16, tileH * 0.16, 0, 0, Math.PI * 2);
                    ctx.fill();

                    // Legs when walking
                    if (isWalking) {
                        const legSwing = Math.sin(actor.walkPhase) * 3.5;
                        ctx.strokeStyle = '#1e293b';
                        ctx.lineWidth = 2.4;
                        ctx.beginPath();
                        ctx.moveTo(p.x - 2.5, p.y - 6); ctx.lineTo(p.x - 2.5 - legSwing, p.y + 1);
                        ctx.moveTo(p.x + 2.5, p.y - 6); ctx.lineTo(p.x + 2.5 + legSwing, p.y + 1);
                        ctx.stroke();
                    }

                    // Torso / Robe / Kimono
                    const robeW = tileW * 0.22;
                    const robeH = tileH * 0.72;
                    const bodyY = p.y - robeH - 3 - bob;
                    ctx.fillStyle = isWaiter ? '#1e293b' : actor.outfit.robe;
                    ctx.beginPath();
                    ctx.roundRect(p.x - robeW * 0.5, bodyY, robeW, robeH, 4);
                    ctx.fill();

                    // Sash / Waiter Apron
                    ctx.fillStyle = isWaiter ? '#f8fafc' : actor.outfit.sash;
                    ctx.fillRect(p.x - robeW * 0.48, bodyY + robeH * 0.45, robeW * 0.96, robeH * 0.25);

                    // Head
                    const headR = tileW * 0.115;
                    const headY = bodyY - headR * 0.85;
                    ctx.fillStyle = '#fde68a';
                    ctx.beginPath();
                    ctx.arc(p.x, headY, headR, 0, Math.PI * 2);
                    ctx.fill();

                    // Hair & Bun
                    ctx.fillStyle = isWaiter ? '#0f172a' : actor.outfit.hair;
                    ctx.beginPath();
                    ctx.arc(p.x, headY - headR * 0.18, headR * 0.98, Math.PI, Math.PI * 2);
                    ctx.fill();
                    ctx.beginPath();
                    ctx.arc(p.x, headY - headR * 0.95, headR * 0.42, 0, Math.PI * 2);
                    ctx.fill();

                    // If Waiter is carrying an order tray
                    if (isWaiter && actor.carryOrder) {
                        ctx.fillStyle = '#fef3c7';
                        ctx.beginPath();
                        ctx.ellipse(p.x + robeW * 0.55, bodyY + robeH * 0.3, 7, 4, 0, 0, Math.PI * 2);
                        ctx.fill();
                        ctx.font = `${Math.max(11, Math.round(tileW * 0.22))}px sans-serif`;
                        ctx.textAlign = 'center';
                        ctx.fillText(actor.carryOrder.icon, p.x + robeW * 0.55, bodyY + robeH * 0.25);
                    }

                    // If Guest is seated & enjoying their served item, draw the dish/book on the table!
                    if (!isWaiter && actor.state === 'ENJOYING' && actor.seat) {
                        const dishPt = isoPt(actor.seat.tableGx, actor.seat.tableGy, 0.68);
                        ctx.fillStyle = '#ffffff';
                        ctx.beginPath();
                        ctx.ellipse(dishPt.x, dishPt.y, 5.5, 3.5, 0, 0, Math.PI * 2);
                        ctx.fill();
                        ctx.font = `${Math.max(11, Math.round(tileW * 0.21))}px sans-serif`;
                        ctx.textAlign = 'center';
                        ctx.fillText(actor.order.icon, dishPt.x, dishPt.y + 2);
                    }

                    // Floating speech bubble for ordering/waiting guests OR happy emote while enjoying
                    if (!isWaiter && (actor.state === 'ORDERING' || actor.state === 'WAITING_FOOD')) {
                        const bx = p.x, by = headY - headR * 2.4;
                        ctx.fillStyle = 'rgba(15, 23, 42, 0.85)';
                        ctx.strokeStyle = 'rgba(251, 191, 36, 0.7)';
                        ctx.lineWidth = 1.2;
                        ctx.beginPath();
                        ctx.roundRect(bx - 13, by - 12, 26, 20, 7);
                        ctx.fill();
                        ctx.stroke();
                        ctx.font = '12px sans-serif';
                        ctx.textAlign = 'center';
                        ctx.fillText(actor.order.icon, bx, by + 2);
                    } else if (!isWaiter && actor.state === 'ENJOYING' && actor.emote) {
                        const bx = p.x, by = headY - headR * 2.2 - Math.sin(t * 4) * 2;
                        ctx.font = '12px sans-serif';
                        ctx.textAlign = 'center';
                        ctx.fillText(actor.emote, bx, by);
                    }
                };

                zenSimGuests.forEach(g => {
                    renderQueue.push({
                        depth: g.gx + g.gy + 0.05,
                        draw: () => drawCharacter(g, false)
                    });
                });

                zenSimWaiters.forEach(wt => {
                    renderQueue.push({
                        depth: wt.gx + wt.gy + 0.05,
                        draw: () => drawCharacter(wt, true)
                    });
                });

                // Sort back-to-front and render all 3D entities
                renderQueue.sort((a, b) => a.depth - b.depth);
                renderQueue.forEach(item => item.draw());

                // 7. Floating `+¥ ★` completion popups
                zenSimFloatTexts.forEach(ft => {
                    const fp = isoPt(ft.gx, ft.gy, ft.gz);
                    ctx.save();
                    ctx.globalAlpha = Math.max(0, ft.alpha);
                    ctx.font = 'bold 13px Plus Jakarta Sans, sans-serif';
                    ctx.fillStyle = ft.color;
                    ctx.textAlign = 'center';
                    ctx.fillText(ft.text, fp.x, fp.y);
                    ctx.restore();
                });

                // 8. Interactive water ripples & drifting fireflies / sakura petals
                for (let i = zenRipples.length - 1; i >= 0; i--) {
                    const rp = zenRipples[i];
                    rp.r += 0.45;
                    rp.alpha *= 0.975;
                    ctx.strokeStyle = `rgba(186, 230, 253, ${rp.alpha})`;
                    ctx.lineWidth = 1.2;
                    ctx.beginPath();
                    ctx.ellipse(rp.x, rp.y, rp.r, rp.r * 0.55, 0, 0, Math.PI * 2);
                    ctx.stroke();
                    if (rp.r >= rp.maxR || rp.alpha < 0.02) zenRipples.splice(i, 1);
                }

                zenParticles.forEach(p => {
                    p.x += p.vx + Math.sin(t + p.phase) * 0.25;
                    p.y += p.vy;
                    if (p.y < -10) { p.y = h + 10; p.x = Math.random() * w; }
                    if (p.x < -10) p.x = w + 10;
                    if (p.x > w + 10) p.x = -10;

                    const glow = 0.45 + 0.55 * Math.abs(Math.sin(t * 1.7 + p.phase));
                    if (p.sakura) {
                        ctx.fillStyle = `rgba(251, 207, 232, ${0.65 * glow})`;
                        ctx.beginPath();
                        ctx.ellipse(p.x, p.y, p.r * 1.4, p.r * 0.8, t + p.phase, 0, Math.PI * 2);
                        ctx.fill();
                    } else {
                        const rg = ctx.createRadialGradient(p.x, p.y, 0.5, p.x, p.y, p.r * 3.8);
                        rg.addColorStop(0, isNight ? `rgba(165, 243, 252, ${0.8 * glow})` : `rgba(254, 240, 138, ${0.8 * glow})`);
                        rg.addColorStop(1, 'rgba(0,0,0,0)');
                        ctx.fillStyle = rg;
                        ctx.beginPath(); ctx.arc(p.x, p.y, p.r * 3.8, 0, Math.PI * 2); ctx.fill();
                    }
                });

                // Optional atmospheric rain streaks if Rain channel is active or Sakura Rain scene is selected
                const rainVol = (state.settings?.mixerLevels?.rain || 0);
                if (isRain || rainVol > 5) {
                    const density = isRain ? 45 : Math.min(60, Math.floor(rainVol * 0.6));
                    ctx.strokeStyle = 'rgba(186, 230, 253, 0.20)';
                    ctx.lineWidth = 1;
                    ctx.beginPath();
                    for (let i = 0; i < density; i++) {
                        const rx = ((i * 97 + t * 850) % (w + 100)) - 50;
                        const ry = ((i * 173 + t * 1550) % (h + 100)) - 50;
                        ctx.moveTo(rx, ry);
                        ctx.lineTo(rx - 6, ry + 20);
                    }
                    ctx.stroke();
                }

                // 9. Top-Left Game HUD (Matching the Reference Screenshot: Star, Currency, Level Bar & Star Rating)
                if (!document.getElementById('subjectView')?.classList.contains('zen-workspace-visible')) {
                    ctx.save();
                    ctx.textAlign = 'left';
                    // Currency Line: ★ ¥585158
                    ctx.font = '300 22px Plus Jakarta Sans, sans-serif';
                    ctx.fillStyle = 'rgba(235, 225, 215, 0.88)';
                    ctx.fillText(`★ ¥${zenSimCoins}`, 22, 36);

                    // Level Badge & Progress Bar: ★ [100] ━━━━━━━
                    ctx.font = 'bold 14px Plus Jakarta Sans, sans-serif';
                    ctx.fillText('★', 22, 66);
                    // Rounded box [100]
                    ctx.strokeStyle = 'rgba(235, 225, 215, 0.65)';
                    ctx.lineWidth = 1.3;
                    ctx.fillStyle = 'rgba(20, 14, 10, 0.55)';
                    ctx.beginPath();
                    ctx.roundRect(44, 48, 34, 26, 6);
                    ctx.fill();
                    ctx.stroke();
                    ctx.fillStyle = 'rgba(235, 225, 215, 0.9)';
                    ctx.font = '600 13px Plus Jakarta Sans, sans-serif';
                    ctx.textAlign = 'center';
                    ctx.fillText(`${zenSimLevel}`, 61, 66);

                    // Progress bar track
                    ctx.beginPath();
                    ctx.roundRect(78, 57, 108, 8, 4);
                    ctx.stroke();
                    ctx.fillStyle = 'rgba(251, 191, 36, 0.65)';
                    ctx.beginPath();
                    ctx.roundRect(79, 58, Math.max(8, 106 * zenSimLevelProgress), 6, 3);
                    ctx.fill();

                    // Vertical Reputation Stars
                    ctx.textAlign = 'left';
                    ctx.font = '15px sans-serif';
                    const starRows = [96, 124, 152];
                    starRows.forEach((sy, idx) => {
                        ctx.fillStyle = idx === 0 ? 'rgba(235, 225, 215, 0.9)' : 'rgba(235, 225, 215, 0.45)';
                        ctx.fillText(idx === 0 ? '★' : '☆', 22, sy);
                    });

                    // Subtle live guest counter under HUD
                    ctx.font = '600 11px Plus Jakarta Sans, sans-serif';
                    ctx.fillStyle = 'rgba(251, 191, 36, 0.72)';
                    ctx.fillText(`${zenSimGuests.length} Scholars in Sanctuary • 2 Tea Staff`, 22, 178);
                    ctx.restore();
                }

                zenAnimFrame = requestAnimationFrame(drawZenFrame);
            }
            zenAnimFrame = requestAnimationFrame(drawZenFrame);
        }


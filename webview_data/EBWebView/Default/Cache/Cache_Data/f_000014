        function toggleSplitScreen() {
            const area = document.getElementById('pdfSplitArea');
            if (!area.classList.contains('hidden')) closeSplitScreen();
            else if (lastSplitFile) splitScreenFile(lastSplitFile.filename, lastSplitFile.isImage);
        }

        async function openNativeFile(filename) {
            try { showToast("Opening file with native app... 🚀"); await fetch(`${API_URL}/open_file/${filename}`); } catch(e) { showToast("Error opening file", true); }
        }
        function downloadFile(filename, originalName) {
            const a = document.createElement('a'); a.href = `${FILES_URL}/${filename}`; a.download = originalName; document.body.appendChild(a); a.click(); document.body.removeChild(a);
        }

        let currentScale = 1, isDragging = false, startX, startY, transX = 0, transY = 0;

        function splitScreenFile(filename, isImage = false) {
            lastSplitFile = { filename, isImage };
            document.getElementById('pdfsContainer').classList.add('hidden');
            if(document.getElementById('bulkActionBar')) document.getElementById('bulkActionBar').classList.add('hidden');
            document.getElementById('pdfSplitArea').classList.remove('hidden'); document.getElementById('pdfSplitArea').classList.add('flex');
            document.getElementById('splitScreenBtn').classList.remove('hidden');
            
            const iframe = document.getElementById('pdfFrame'), img = document.getElementById('zoomableImage'), zoomControls = document.getElementById('zoomControls');
            if(isImage) {
                iframe.classList.add('hidden'); img.classList.remove('hidden'); zoomControls.classList.remove('hidden');
                img.src = `${FILES_URL}/${filename}`; resetZoom();
            } else {
                img.classList.add('hidden'); zoomControls.classList.add('hidden'); iframe.classList.remove('hidden');
                iframe.src = `${FILES_URL}/${filename}`;
            }
        }
        
        function zoomImage(step) { currentScale = Math.max(0.5, Math.min(currentScale + step, 5)); updateImageTransform(); }
        function resetZoom() { currentScale = 1; transX = 0; transY = 0; updateImageTransform(); }
        function updateImageTransform() { document.getElementById('zoomableImage').style.transform = `translate(${transX}px, ${transY}px) scale(${currentScale})`; }

        const imgEl = document.getElementById('zoomableImage');
        imgEl.addEventListener('mousedown', (e) => { isDragging = true; startX = e.clientX - transX; startY = e.clientY - transY; imgEl.style.cursor = 'grabbing'; });
        window.addEventListener('mouseup', () => { isDragging = false; imgEl.style.cursor = 'move'; });
        window.addEventListener('mousemove', (e) => { if(!isDragging) return; transX = e.clientX - startX; transY = e.clientY - startY; updateImageTransform(); });

        // [INJECTED] Resizable Split Screen Logic
        function setupSplitScreenResizer() {
            const resizer = document.getElementById('resizer');
            const leftPanel = document.getElementById('splitNotesPanel');
            const rightPanel = document.getElementById('splitViewContainer');
            const container = document.getElementById('pdfSplitArea');
            let isResizing = false;
            if(!resizer) return;
            resizer.addEventListener('mousedown', () => isResizing = true);
            document.addEventListener('mousemove', (e) => {
                if(!isResizing) return;
                let newWidth = (e.clientX - container.getBoundingClientRect().left) / container.clientWidth * 100;
                if(newWidth > 20 && newWidth < 80) { leftPanel.style.width = `${newWidth}%`; rightPanel.style.width = `${100 - newWidth}%`; }
            });
            document.addEventListener('mouseup', () => isResizing = false);
        }

        function closeSplitScreen() {
            document.getElementById('pdfSplitArea').classList.add('hidden'); document.getElementById('pdfSplitArea').classList.remove('flex');
            document.getElementById('pdfsContainer').classList.remove('hidden');
            document.getElementById('pdfFrame').src = ''; document.getElementById('zoomableImage').src = '';
            updateBulkBar();
        }


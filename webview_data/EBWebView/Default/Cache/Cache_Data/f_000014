        // ================= VOICE RECORDINGS & WAVESURFER PLAYER =================
        let mediaRecorder = null, recStream = null, recChunks = [], recStartTime = 0, recPausedMs = 0, recPauseStarted = 0, recTimerInt = null;
        let recAudioCtx = null, recAnalyser = null, recAnimFrame = null;
        let waveSurfer = null, activeRecordingId = null, voiceLoop = false, voiceSpeed = 1, voiceMuted = false;

        function formatDuration(sec) {
            if (!isFinite(sec) || sec < 0) sec = 0;
            const m = Math.floor(sec / 60).toString().padStart(2, '0');
            const s = Math.floor(sec % 60).toString().padStart(2, '0');
            return `${m}:${s}`;
        }

        function pickRecordingMime() {
            const types = ['audio/webm;codecs=opus', 'audio/webm', 'audio/ogg;codecs=opus', 'audio/mp4'];
            if (typeof MediaRecorder !== 'undefined' && MediaRecorder.isTypeSupported) {
                for (const t of types) if (MediaRecorder.isTypeSupported(t)) return t;
            }
            return '';
        }

        async function startVoiceRecording() {
            if (mediaRecorder && mediaRecorder.state !== 'inactive') return;
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                return showToast('Microphone recording is not supported on this device', true);
            }
            try {
                recStream = await navigator.mediaDevices.getUserMedia({ audio: true });
                const mimeType = pickRecordingMime();
                mediaRecorder = mimeType ? new MediaRecorder(recStream, { mimeType }) : new MediaRecorder(recStream);
                recChunks = [];
                mediaRecorder.ondataavailable = (e) => { if (e.data && e.data.size > 0) recChunks.push(e.data); };
                mediaRecorder.start(200);

                recStartTime = Date.now(); recPausedMs = 0; recPauseStarted = 0;
                document.getElementById('recStartBtn').classList.add('hidden');
                document.getElementById('recPauseBtn').classList.remove('hidden'); document.getElementById('recPauseBtn').classList.add('flex');
                document.getElementById('recStopBtn').classList.remove('hidden'); document.getElementById('recStopBtn').classList.add('flex');
                document.getElementById('recCancelBtn').classList.remove('hidden'); document.getElementById('recCancelBtn').classList.add('flex');
                document.getElementById('recLiveStatus').classList.remove('hidden'); document.getElementById('recLiveStatus').classList.add('flex');
                document.getElementById('recPauseText').textContent = 'Pause';
                document.getElementById('recPulseDot').classList.add('animate-ping');

                clearInterval(recTimerInt);
                recTimerInt = setInterval(() => {
                    if (mediaRecorder && mediaRecorder.state === 'recording') {
                        const elapsed = Math.floor((Date.now() - recStartTime - recPausedMs) / 1000);
                        document.getElementById('recTimerDisplay').textContent = formatDuration(elapsed);
                    }
                }, 250);

                startLiveMicVisualizer(recStream);
                showToast('Recording started 🎙️');
            } catch (err) {
                showToast('Could not access microphone. Check mic connection or permissions.', true);
            }
        }

        function startLiveMicVisualizer(stream) {
            try {
                recAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const src = recAudioCtx.createMediaStreamSource(stream);
                recAnalyser = recAudioCtx.createAnalyser();
                recAnalyser.fftSize = 64;
                src.connect(recAnalyser);
                const data = new Uint8Array(recAnalyser.frequencyBinCount);
                const cv = document.getElementById('recLiveCanvas');
                const c = cv.getContext('2d');

                const draw = () => {
                    if (!recAnalyser) return;
                    recAnimFrame = requestAnimationFrame(draw);
                    recAnalyser.getByteFrequencyData(data);
                    c.clearRect(0, 0, cv.width, cv.height);
                    const bars = 18, step = Math.floor(data.length / bars);
                    for (let i = 0; i < bars; i++) {
                        const v = data[i * step] / 255;
                        const h = Math.max(3, v * cv.height);
                        c.fillStyle = i % 2 === 0 ? '#f43f5e' : '#a855f7';
                        c.fillRect(i * 5, (cv.height - h) / 2, 3, h);
                    }
                };
                draw();
            } catch (e) {}
        }

        function pauseVoiceRecording() {
            if (!mediaRecorder) return;
            const txt = document.getElementById('recPauseText'), dot = document.getElementById('recPulseDot');
            if (mediaRecorder.state === 'recording') {
                mediaRecorder.pause();
                recPauseStarted = Date.now();
                txt.textContent = 'Resume';
                dot.classList.remove('animate-ping');
            } else if (mediaRecorder.state === 'paused') {
                mediaRecorder.resume();
                if (recPauseStarted) { recPausedMs += Date.now() - recPauseStarted; recPauseStarted = 0; }
                txt.textContent = 'Pause';
                dot.classList.add('animate-ping');
            }
        }

        function cleanupRecordingHardware() {
            clearInterval(recTimerInt); recTimerInt = null;
            if (recAnimFrame) cancelAnimationFrame(recAnimFrame); recAnimFrame = null;
            recAnalyser = null;
            if (recAudioCtx) { try { recAudioCtx.close(); } catch(e){} recAudioCtx = null; }
            if (recStream) { recStream.getTracks().forEach(t => t.stop()); recStream = null; }
            document.getElementById('recStartBtn').classList.remove('hidden');
            ['recPauseBtn', 'recStopBtn', 'recCancelBtn', 'recLiveStatus'].forEach(id => {
                const el = document.getElementById(id);
                el.classList.add('hidden'); el.classList.remove('flex');
            });
            document.getElementById('recTimerDisplay').textContent = '00:00';
        }

        function stopVoiceRecording(shouldSave = true) {
            if (!mediaRecorder || mediaRecorder.state === 'inactive') { cleanupRecordingHardware(); return; }
            const durationSec = Math.max(1, Math.round((Date.now() - recStartTime - recPausedMs - (recPauseStarted ? Date.now() - recPauseStarted : 0)) / 1000));
            const mime = mediaRecorder.mimeType || 'audio/webm';
            mediaRecorder.onstop = async () => {
                const chunks = recChunks.slice();
                recChunks = []; mediaRecorder = null;
                cleanupRecordingHardware();
                if (!shouldSave || chunks.length === 0) {
                    showToast('Recording discarded'); return;
                }
                const ext = mime.includes('ogg') ? '.ogg' : mime.includes('mp4') ? '.m4a' : '.webm';
                const blob = new Blob(chunks, { type: mime });
                const rawTitle = document.getElementById('recTitleInput').value.trim();
                const nowStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                const title = rawTitle || `Voice Note (${nowStr})`;
                await uploadAndSaveRecording(blob, `${title.replace(/[^a-zA-Z0-9_\- ]/g, '').trim() || 'voice_note'}${ext}`, title, durationSec);
                document.getElementById('recTitleInput').value = '';
            };
            mediaRecorder.stop();
        }

        async function uploadAndSaveRecording(fileOrBlob, filename, title, durationSec = 0) {
            const fd = new FormData();
            fd.append('files[]', fileOrBlob, filename);
            fd.append('subject_id', state.currentSubjectId);
            fd.append('folder', 'Recordings');
            try {
                const res = await fetch(`${API_URL}/upload_file`, { method: 'POST', body: fd });
                const result = await res.json();
                if (result.status === 'success' && result.files && result.files.length) {
                    const f = result.files[0];
                    const recObj = {
                        id: 'rec_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
                        subjectId: state.currentSubjectId,
                        title: title,
                        filename: f.filename,
                        date: new Date().toLocaleDateString('en-GB') + ' • ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
                        duration: durationSec ? formatDuration(durationSec) : 'Audio'
                    };
                    state.recordings.unshift(recObj);
                    saveData(); trackActivity(); renderRecordings(); updateSubjectStats(state.currentSubjectId);
                    loadVoiceRecording(recObj.id, false);
                    showToast('Voice recording saved! 🎧');
                } else {
                    showToast(result.error || 'Could not save recording', true);
                }
            } catch (err) {
                showToast('Failed to save recording', true);
            }
        }

        async function handleAudioUpload(e) {
            const files = e.target.files;
            if (!files || !files.length) return;
            const customTitle = document.getElementById('recTitleInput').value.trim();
            showToast(`Importing ${files.length} audio file(s)... ⏳`);
            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                const defaultTitle = file.name.replace(/\.[^/.]+$/, '');
                const title = (files.length === 1 && customTitle) ? customTitle : defaultTitle;
                await uploadAndSaveRecording(file, file.name, title, 0);
            }
            document.getElementById('recTitleInput').value = '';
            e.target.value = '';
        }

        function ensureWaveSurfer() {
            const container = document.getElementById('waveformContainer');
            if (!container) return null;
            if (waveSurfer) return waveSurfer;
            if (typeof window.WaveSurfer === 'undefined') return null;

            const ctx = document.createElement('canvas').getContext('2d');
            const waveGrad = ctx.createLinearGradient(0, 0, 0, 80);
            waveGrad.addColorStop(0, '#9d82ff');
            waveGrad.addColorStop(0.5, '#7c5cff');
            waveGrad.addColorStop(1, '#22d3ee');

            const progGrad = ctx.createLinearGradient(0, 0, 0, 80);
            progGrad.addColorStop(0, '#f472b6');
            progGrad.addColorStop(0.5, '#a855f7');
            progGrad.addColorStop(1, '#06b6d4');

            waveSurfer = WaveSurfer.create({
                container: container,
                height: 68,
                barWidth: 3,
                barGap: 2,
                barRadius: 4,
                cursorWidth: 2,
                cursorColor: '#f472b6',
                waveColor: waveGrad,
                progressColor: progGrad,
                normalize: true,
                interact: true
            });

            waveSurfer.on('ready', () => {
                const dur = waveSurfer.getDuration();
                document.getElementById('playerDuration').textContent = formatDuration(dur);
                document.getElementById('waveformEmptyHint').classList.add('hidden');
                waveSurfer.setPlaybackRate(voiceSpeed);
                waveSurfer.setVolume(voiceMuted ? 0 : parseFloat(document.getElementById('playerVolumeSlider').value || 1));
                // Save accurate duration onto the recording record if it was imported as "Audio"
                const rec = (state.recordings || []).find(r => r.id === activeRecordingId);
                if (rec && dur > 0 && rec.duration === 'Audio') {
                    rec.duration = formatDuration(dur);
                    saveData(); renderRecordingsListOnly();
                }
            });
            waveSurfer.on('audioprocess', () => {
                document.getElementById('playerCurrentTime').textContent = formatDuration(waveSurfer.getCurrentTime());
            });
            waveSurfer.on('seeking', () => {
                document.getElementById('playerCurrentTime').textContent = formatDuration(waveSurfer.getCurrentTime());
            });
            waveSurfer.on('play', () => updatePlayerIcons(true));
            waveSurfer.on('pause', () => updatePlayerIcons(false));
            waveSurfer.on('finish', () => {
                if (voiceLoop) { waveSurfer.seekTo(0); waveSurfer.play(); }
                else updatePlayerIcons(false);
            });
            return waveSurfer;
        }

        function updatePlayerIcons(isPlaying) {
            const icon = document.getElementById('playerPlayPauseIcon');
            if (icon) icon.className = isPlaying ? 'fa-solid fa-pause' : 'fa-solid fa-play';
            document.querySelectorAll('[data-rec-play-icon]').forEach(el => {
                const id = el.getAttribute('data-rec-play-icon');
                el.className = (id === activeRecordingId && isPlaying) ? 'fa-solid fa-pause' : 'fa-solid fa-play';
            });
        }

        function loadVoiceRecording(id, autoPlay = true) {
            const rec = (state.recordings || []).find(r => r.id === id);
            if (!rec) return;
            if (activeRecordingId === id) {
                if (autoPlay) toggleVoicePlayPause();
                return;
            }
            activeRecordingId = id;
            document.getElementById('playerTrackTitle').textContent = rec.title;
            document.getElementById('playerTrackMeta').textContent = `${rec.date} • ${rec.duration || 'Voice Recording'}`;
            document.getElementById('playerCurrentTime').textContent = '00:00';
            document.getElementById('waveformEmptyHint').classList.add('hidden');
            renderRecordingsListOnly();

            const url = `${FILES_URL}/${encodeURIComponent(rec.filename)}`;
            const ws = ensureWaveSurfer();
            if (ws) {
                ws.load(url).then(() => { if (autoPlay) ws.play(); }).catch(() => {});
            } else {
                const audio = document.getElementById('fallbackAudioPlayer');
                audio.src = url;
                audio.playbackRate = voiceSpeed;
                audio.loop = voiceLoop;
                audio.onloadedmetadata = () => { document.getElementById('playerDuration').textContent = formatDuration(audio.duration); };
                audio.ontimeupdate = () => { document.getElementById('playerCurrentTime').textContent = formatDuration(audio.currentTime); };
                audio.onplay = () => updatePlayerIcons(true);
                audio.onpause = () => updatePlayerIcons(false);
                if (autoPlay) audio.play();
            }
        }

        function toggleVoicePlayPause() {
            if (!activeRecordingId) {
                const first = (state.recordings || []).find(r => r.subjectId === state.currentSubjectId);
                if (first) return loadVoiceRecording(first.id, true);
                return showToast('Record or select a voice note first!', true);
            }
            if (waveSurfer) {
                waveSurfer.playPause();
            } else {
                const audio = document.getElementById('fallbackAudioPlayer');
                if (audio.paused) audio.play(); else audio.pause();
            }
        }

        function seekVoicePlayer(deltaSec) {
            if (!activeRecordingId) return;
            if (waveSurfer) {
                const dur = waveSurfer.getDuration() || 1;
                const next = Math.min(dur, Math.max(0, waveSurfer.getCurrentTime() + deltaSec));
                waveSurfer.seekTo(next / dur);
            } else {
                const audio = document.getElementById('fallbackAudioPlayer');
                audio.currentTime = Math.max(0, (audio.currentTime || 0) + deltaSec);
            }
        }

        function toggleVoiceLoop() {
            voiceLoop = !voiceLoop;
            const btn = document.getElementById('playerLoopBtn');
            btn.className = voiceLoop
                ? 'w-10 h-10 rounded-xl bg-brand-600 text-white flex items-center justify-center shadow-sm transition'
                : 'w-10 h-10 rounded-xl bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400 hover:text-brand-500 flex items-center justify-center transition';
            const audio = document.getElementById('fallbackAudioPlayer');
            if (audio) audio.loop = voiceLoop;
        }

        function setVoiceSpeed(rate) {
            voiceSpeed = rate;
            if (waveSurfer) waveSurfer.setPlaybackRate(rate);
            const audio = document.getElementById('fallbackAudioPlayer');
            if (audio) audio.playbackRate = rate;
            document.querySelectorAll('.voice-speed-btn').forEach(btn => {
                const isActive = parseFloat(btn.getAttribute('data-speed')) === rate;
                btn.className = isActive
                    ? 'voice-speed-btn px-2.5 py-1 rounded-lg text-xs font-bold bg-brand-600 text-white shadow-sm transition'
                    : 'voice-speed-btn px-2.5 py-1 rounded-lg text-xs font-bold text-gray-500 dark:text-gray-400 hover:text-brand-500 transition';
            });
        }

        function setVoiceVolume(val) {
            const v = parseFloat(val);
            voiceMuted = (v === 0);
            if (waveSurfer) waveSurfer.setVolume(v);
            const audio = document.getElementById('fallbackAudioPlayer');
            if (audio) audio.volume = v;
            document.getElementById('playerVolumeIcon').className = v === 0 ? 'fa-solid fa-volume-xmark text-rose-500 text-sm' : v < 0.5 ? 'fa-solid fa-volume-low text-sm' : 'fa-solid fa-volume-high text-sm';
        }

        function toggleVoiceMute() {
            const slider = document.getElementById('playerVolumeSlider');
            if (!voiceMuted) {
                slider.dataset.prev = slider.value || '1';
                slider.value = 0;
                setVoiceVolume(0);
            } else {
                const prev = parseFloat(slider.dataset.prev || '1') || 1;
                slider.value = prev;
                setVoiceVolume(prev);
            }
        }

        function renameVoiceRecording(id) {
            const rec = (state.recordings || []).find(r => r.id === id);

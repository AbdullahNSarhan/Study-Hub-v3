        async function processConverterQueue() {
            if (isConvertingBatch) return;
            const pending = converterQueue.filter(x => x.status === 'queued' || x.status === 'error');
            if (pending.length === 0) return showToast('Add files to the conversion queue first!', true);

            isConvertingBatch = true;
            const runBtn = document.getElementById('converterRunBtn');
            if (runBtn) { runBtn.disabled = true; runBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Converting Batch...'; }

            const summaryWrap = document.getElementById('converterBatchSummary');
            const statusTxt = document.getElementById('converterBatchStatusText');
            const pctTxt = document.getElementById('converterBatchPercentText');
            const barEl = document.getElementById('converterBatchProgressBar');
            if (summaryWrap) { summaryWrap.classList.remove('hidden'); summaryWrap.classList.add('flex'); }

            const attachChk = document.getElementById('converterAttachSubjectChk')?.checked;
            const subId = attachChk ? document.getElementById('converterSubjectSelect')?.value : '';
            const folderName = attachChk ? document.getElementById('converterFolderSelect')?.value : 'Lectures';
            const saveDir = (state.settings?.defaultSaveLocation || '').trim();

            let completed = 0;
            for (let i = 0; i < pending.length; i++) {
                const item = pending[i];
                item.status = 'converting';
                item.progress = 45;
                if (statusTxt) statusTxt.textContent = `Converting (${i + 1}/${pending.length}): ${item.name}...`;
                const overallPct = Math.round((i / pending.length) * 100);
                if (pctTxt) pctTxt.textContent = `${overallPct}%`;
                if (barEl) barEl.style.width = `${overallPct}%`;
                renderConverterQueue();

                const fd = new FormData();
                fd.append('files[]', item.file, item.name);
                if (saveDir) fd.append('save_dir', saveDir);
                if (subId) {
                    fd.append('subject_id', subId);
                    fd.append('folder', folderName || 'Lectures');
                }

                try {
                    const res = await fetch(`${API_URL}/convert_to_pdf`, { method: 'POST', body: fd });
                    const data = await res.json();
                    if (res.ok && data.results && data.results.length > 0) {
                        const r = data.results[0];
                        item.status = 'done';
                        item.progress = 100;
                        item.outputPath = r.output_path;
                        item.pdfName = r.pdf_name;
                        completed++;

                        if (r.subject_file && subId) {
                            state.pdfs.push({
                                id: 'file_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
                                subjectId: subId,
                                original_name: r.subject_file.original_name,
                                filename: r.subject_file.filename,
                                folder: r.subject_file.folder
                            });
                        }
                    } else {
                        item.status = 'error';
                        item.progress = 100;
                        item.errorMsg = (data.errors && data.errors[0]?.error) || data.error || 'Conversion failed';
                    }
                } catch (err) {
                    item.status = 'error';
                    item.progress = 100;
                    item.errorMsg = 'Server connection error';
                }
                renderConverterQueue();
            }

            if (pctTxt) pctTxt.textContent = '100%';
            if (barEl) barEl.style.width = '100%';
            if (statusTxt) statusTxt.textContent = `Batch finished: ${completed} of ${pending.length} converted to PDF`;

            if (subId && completed > 0) {
                saveData();
                trackActivity();
                if (state.currentSubjectId === subId) {
                    renderFiles();
                    updateSubjectStats(subId);
                }
                renderSubjectsGrid();
            }

            isConvertingBatch = false;
            if (runBtn) { runBtn.disabled = false; runBtn.innerHTML = '<i class="fa-solid fa-wand-magic-sparkles"></i> Convert All to PDF'; }
            if (completed > 0) showToast(`Converted ${completed} file(s) to PDF! 📄`);
            else showToast('Conversion failed — check file format.', true);
        }


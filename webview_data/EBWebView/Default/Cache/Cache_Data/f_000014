        // Compute orderly orthogonal walkway path between two grid points avoiding the central pond (6..10.8)
        function buildSanctuaryWaypoints(sx, sy, tx, ty) {
            const pts = [];
            // Nearest corridor ring coordinate (corridors are at x=3.8, y=3.8, x=12.1, y=12.1)
            const pickCorridor = (x, y) => {
                const cx = (Math.abs(x - 3.8) < Math.abs(x - 12.1)) ? 3.8 : 12.1;
                const cy = (Math.abs(y - 3.8) < Math.abs(y - 12.1)) ? 3.8 : 12.1;
                return [cx, cy];
            };
            const [scx, scy] = pickCorridor(sx, sy);
            const [tcx, tcy] = pickCorridor(tx, ty);

            pts.push({ gx: scx, gy: sy });
            pts.push({ gx: scx, gy: scy });
            if (Math.abs(scx - tcx) > 0.2 && Math.abs(scy - tcy) > 0.2) {
                pts.push({ gx: tcx, gy: scy });
            }
            pts.push({ gx: tcx, gy: tcy });
            pts.push({ gx: tx, gy: tcy });
            pts.push({ gx: tx, gy: ty });
            return pts;
        }

        function spawnZenSanctuaryGuest(manualToast = false, preSeated = false) {
            initZenSanctuarySimulation();
            const freeSeats = zenSimSeats.filter(s => !s.occupiedBy);
            if (!freeSeats.length) {
                if (manualToast) showToast('All sanctuary tables are currently full! 🍵');
                return false;
            }
            if (zenSimGuests.length >= 13 && !manualToast) return false;

            const seat = freeSeats[Math.floor(Math.random() * freeSeats.length)];
            const guestId = zenGuestSeq++;
            seat.occupiedBy = guestId;

            const outfit = ZEN_OUTFITS[guestId % ZEN_OUTFITS.length];
            const order = ZEN_ORDERS[Math.floor(Math.random() * ZEN_ORDERS.length)];
            const doorGx = 0.45, doorGy = 4.2 + (Math.random() - 0.5) * 0.3;

            if (preSeated) {
                zenSimGuests.push({
                    id: guestId,
                    gx: seat.gx,
                    gy: seat.gy,
                    seat,
                    outfit,
                    order,
                    state: Math.random() > 0.35 ? 'ENJOYING' : 'WAITING_FOOD',
                    beingServed: false,
                    timer: 260 + Math.floor(Math.random() * 520),

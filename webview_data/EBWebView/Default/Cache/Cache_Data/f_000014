        function getConverterFileBadge(filename) {
            const ext = (filename.split('.').pop() || '').toLowerCase();
            if (['doc', 'docx'].includes(ext)) return { icon: 'fa-file-word text-blue-500', tag: 'Word' };
            if (['xls', 'xlsx', 'csv'].includes(ext)) return { icon: 'fa-file-excel text-emerald-500', tag: 'Excel' };
            if (['ppt', 'pptx'].includes(ext)) return { icon: 'fa-file-powerpoint text-orange-500', tag: 'PowerPoint' };
            if (['png', 'jpg', 'jpeg', 'webp', 'bmp', 'gif'].includes(ext)) return { icon: 'fa-file-image text-purple-500', tag: 'Image' };
            return { icon: 'fa-file-lines text-gray-500', tag: ext.toUpperCase() };
        }

        function formatBytes(bytes) {
            if (!bytes || bytes < 1024) return `${bytes || 0} B`;
            if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
            return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
        }

        function addFilesToConverterQueue(fileList) {
            const allowed = ['doc', 'docx', 'xls', 'xlsx', 'ppt', 'pptx', 'png', 'jpg', 'jpeg', 'webp', 'bmp', 'gif', 'txt', 'md', 'csv'];
            let added = 0;
            Array.from(fileList).forEach(file => {
                const ext = (file.name.split('.').pop() || '').toLowerCase();
                if (!allowed.includes(ext)) {
                    showToast(`Skipped unsupported file: ${file.name}`, true);
                    return;
                }
                converterQueue.push({
                    id: 'q_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
                    file: file,
                    name: file.name,
                    size: file.size,
                    status: 'queued', // queued | converting | done | error
                    progress: 0,
                    outputPath: null,
                    pdfName: null,
                    errorMsg: null
                });
                added++;
            });
            if (added > 0) renderConverterQueue();
        }

        function removeConverterQueueItem(id) {

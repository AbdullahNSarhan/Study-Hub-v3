        function getFileIconInfo(filename) {
            const ext = (filename.split('.').pop() || '').toLowerCase();
            if (['pdf'].includes(ext)) return { icon: 'fa-file-pdf', color: 'text-rose-500', badge: 'bg-rose-500/10 text-rose-500', label: 'PDF', isSplitable: true, isImage: false };
            if (['doc', 'docx'].includes(ext)) return { icon: 'fa-file-word', color: 'text-sky-500', badge: 'bg-sky-500/10 text-sky-500', label: 'DOC', isSplitable: false, isImage: false };
            if (['ppt', 'pptx'].includes(ext)) return { icon: 'fa-file-powerpoint', color: 'text-orange-500', badge: 'bg-orange-500/10 text-orange-500', label: 'PPT', isSplitable: false, isImage: false };
            if (['xls', 'xlsx', 'csv'].includes(ext)) return { icon: 'fa-file-excel', color: 'text-emerald-500', badge: 'bg-emerald-500/10 text-emerald-500', label: 'XLS', isSplitable: false, isImage: false };
            if (['png', 'jpg', 'jpeg', 'gif', 'webp', 'svg'].includes(ext)) return { icon: 'fa-file-image', color: 'text-purple-500', badge: 'bg-purple-500/10 text-purple-500', label: 'IMG', isSplitable: true, isImage: true };
            if (['txt', 'md'].includes(ext)) return { icon: 'fa-file-lines', color: 'text-cyan-500', badge: 'bg-cyan-500/10 text-cyan-500', label: 'TXT', isSplitable: true, isImage: false };
            if (['zip'].includes(ext)) return { icon: 'fa-file-zipper', color: 'text-amber-500', badge: 'bg-amber-500/10 text-amber-500', label: 'ZIP', isSplitable: false, isImage: false };
            return { icon: 'fa-file', color: 'text-gray-400', badge: 'bg-gray-500/10 text-gray-400', label: ext.toUpperCase() || 'FILE', isSplitable: false, isImage: false };
        }


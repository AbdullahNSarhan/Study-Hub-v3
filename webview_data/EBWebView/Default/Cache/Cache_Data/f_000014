        function ensureFoldersExist(sub) { if(!sub.folders || sub.folders.length === 0) sub.folders = [...DEFAULT_FOLDERS]; }

        function promptNewFolder() {
            requestInput('New Folder Name', 'e.g., Past Exams, Cheat Sheets', (folderName) => {
                const sub = state.subjects.find(s => s.id === state.currentSubjectId);
                if(!sub) return;
                ensureFoldersExist(sub);
                if(!sub.folders.includes(folderName)) {
                    sub.folders.push(folderName);
                    expandedFolders.add(folderName);
                    saveData(); renderFiles(); showToast("Folder created! 📁");
                } else showToast("Folder already exists!", true);
            });
        }

        function renameFolder(oldName) {
            const sub = state.subjects.find(s => s.id === state.currentSubjectId);
            if (!sub) return;
            requestInput('Rename Folder', oldName, (newName) => {
                if (newName === oldName) return;
                if (sub.folders.includes(newName)) return showToast('A folder with that name already exists!', true);
                const idx = sub.folders.indexOf(oldName);
                if (idx > -1) sub.folders[idx] = newName;
                state.pdfs.forEach(p => { if (p.subjectId === sub.id && p.folder === oldName) p.folder = newName; });
                if (expandedFolders.has(oldName)) { expandedFolders.delete(oldName); expandedFolders.add(newName); }
                saveData(); renderFiles(); showToast('Folder renamed! ✏️');
            });
        }

        function deleteFolder(folderName) {
            const sub = state.subjects.find(s => s.id === state.currentSubjectId);
            if (!sub) return;
            if (sub.folders.length <= 1) return showToast('Subject must keep at least one folder!', true);
            const fFiles = state.pdfs.filter(p => p.subjectId === sub.id && p.folder === folderName);
            const msg = fFiles.length
                ? `Delete folder "${folderName}" and its ${fFiles.length} file(s) permanently?`
                : `Delete empty folder "${folderName}"?`;
            requestConfirm(msg, async () => {
                for (const p of fFiles) {
                    try { await fetch(`${API_URL}/delete_file/${encodeURIComponent(p.filename)}`, { method: 'DELETE' }); } catch (e) {}
                }
                state.pdfs = state.pdfs.filter(p => !(p.subjectId === sub.id && p.folder === folderName));
                sub.folders = sub.folders.filter(f => f !== folderName);
                expandedFolders.delete(folderName);
                saveData(); renderFiles(); updateSubjectStats(sub.id);
                showToast('Folder deleted');
            });
        }

        function toggleFolderCollapse(folderName) {
            if (expandedFolders.has(folderName)) expandedFolders.delete(folderName);
            else expandedFolders.add(folderName);
            renderFiles();
        }


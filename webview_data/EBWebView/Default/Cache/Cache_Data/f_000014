        let canvas, ctx, isDrawing = false;
        function initWhiteboard() {
            canvas = document.getElementById('whiteboardCanvas'); if(!canvas) return;
            const container = document.getElementById('canvasContainer');
            canvas.width = container.clientWidth; canvas.height = container.clientHeight;
            ctx = canvas.getContext('2d'); ctx.lineCap = 'round'; ctx.lineJoin = 'round';
            canvas.style.touchAction = 'none';
            let last = null;
            const pos = (e) => { const r = canvas.getBoundingClientRect(); return [e.clientX - r.left, e.clientY - r.top]; };
            canvas.onpointerdown = (e) => { isDrawing = true; last = pos(e); canvas.setPointerCapture(e.pointerId);
                ctx.fillStyle = document.getElementById('wbColor').value; ctx.beginPath(); ctx.arc(last[0], last[1], document.getElementById('wbSize').value / 2, 0, Math.PI * 2); ctx.fill(); };
            canvas.onpointermove = (e) => { if(!isDrawing) return; const p = pos(e);
                ctx.beginPath(); ctx.moveTo(last[0], last[1]); ctx.lineTo(p[0], p[1]);
                ctx.strokeStyle = document.getElementById('wbColor').value; ctx.lineWidth = document.getElementById('wbSize').value; ctx.stroke(); last = p; };
            canvas.onpointerup = canvas.onpointercancel = () => { isDrawing = false; };
        }
        function clearWhiteboard() { ctx.clearRect(0,0,canvas.width,canvas.height); }
        function saveWhiteboard() {
            const tempCanvas = document.createElement('canvas'); tempCanvas.width = canvas.width; tempCanvas.height = canvas.height;
            const tCtx = tempCanvas.getContext('2d'); tCtx.fillStyle = '#ffffff'; tCtx.fillRect(0, 0, tempCanvas.width, tempCanvas.height); tCtx.drawImage(canvas, 0, 0);
            state.whiteboards.unshift({ id: 'wb_'+Date.now(), subjectId: state.currentSubjectId, img: tempCanvas.toDataURL('image/jpeg', 0.8) });

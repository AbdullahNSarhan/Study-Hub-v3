        // [INJECTED] Universal Drag and Drop engine logic
        function dragStart(e, type, id, folder = null) {
            e.stopPropagation(); draggedItem = { type, id, folder }; e.dataTransfer.effectAllowed = "move"; e.target.style.opacity = '0.5';
        }
        function dragOver(e) { e.preventDefault(); e.stopPropagation(); if(!e.currentTarget.classList.contains('drag-over')) e.currentTarget.classList.add('drag-over'); }
        function dragLeave(e) { e.preventDefault(); e.stopPropagation(); e.currentTarget.classList.remove('drag-over'); }
        function drop(e, targetType, targetId, targetFolder = null) {
            e.preventDefault(); e.stopPropagation(); e.currentTarget.classList.remove('drag-over');
            document.querySelectorAll('[draggable]').forEach(el => el.style.opacity = '1');
            if(!draggedItem || draggedItem.id === targetId) return;

            if(draggedItem.type === 'file' && targetType === 'folder') {
                const f = state.pdfs.find(p => p.id === draggedItem.id);
                if(f) { f.folder = targetId; saveData(); renderFiles(); }
                draggedItem = null; return;
            }
            if(draggedItem.type === 'folder' && targetType === 'folder') {
                const sub = state.subjects.find(s => s.id === state.currentSubjectId);
                const fromIdx = sub.folders.indexOf(draggedItem.id), toIdx = sub.folders.indexOf(targetId);
                if(fromIdx > -1 && toIdx > -1) {
                    const [moved] = sub.folders.splice(fromIdx, 1);
                    sub.folders.splice(toIdx, 0, moved); saveData(); renderFiles();
                }
                draggedItem = null; return;
            }
            if(draggedItem.type === targetType) {
                let arrKey = draggedItem.type + 's';
                if(draggedItem.type === 'file') arrKey = 'pdfs';
                if(draggedItem.type === 'subject') arrKey = 'subjects';
                if(state[arrKey]) {
                    const arr = state[arrKey];
                    const fromIdx = arr.findIndex(i => i.id === draggedItem.id), toIdx = arr.findIndex(i => i.id === targetId);
                    if(fromIdx > -1 && toIdx > -1) {
                        const [moved] = arr.splice(fromIdx, 1);
                        if(draggedItem.type === 'file' && targetFolder) moved.folder = targetFolder;
                        arr.splice(toIdx, 0, moved); saveData();
                        if(draggedItem.type === 'file') renderFiles();
                        if(draggedItem.type === 'video') renderVideos();
                        if(draggedItem.type === 'recording') renderRecordings();
                        if(draggedItem.type === 'note') renderNotes();
                        if(draggedItem.type === 'task') renderTasks();
                        if(draggedItem.type === 'link') renderLinks();
                        if(draggedItem.type === 'flashcard') renderFlashcards();
                        if(draggedItem.type === 'deadline') renderDeadlines();
                        if(draggedItem.type === 'subject') renderSubjectsGrid();
                    }
                }
            }
            draggedItem = null;
        }


        let videoWaveSurfer = null, activeVideoId = null, videoLoop = false, videoSpeed = 1, videoMuted = false, videoEventsBound = false;

        function bindStudioVideoEvents() {
            if (videoEventsBound) return;
            const v = document.getElementById('studioVideoPlayer');
            if (!v) return;
            videoEventsBound = true;

            v.addEventListener('loadedmetadata', () => {
                const dur = v.duration || 0;
                document.getElementById('videoDuration').textContent = formatDuration(dur);
                v.playbackRate = videoSpeed;
                v.loop = videoLoop;
                v.volume = videoMuted ? 0 : parseFloat(document.getElementById('videoVolumeSlider').value || 1);
                const rec = (state.videos || []).find(x => x.id === activeVideoId);
                if (rec && dur > 0 && rec.duration === 'Video') {
                    rec.duration = formatDuration(dur);
                    saveData(); renderVideosListOnly();
                }
            });
            v.addEventListener('timeupdate', () => {
                const cur = v.currentTime || 0, dur = v.duration || 1;
                document.getElementById('videoCurrentTime').textContent = formatDuration(cur);
                document.getElementById('videoSeekSlider').value = Math.round((cur / dur) * 1000) || 0;
            });
            v.addEventListener('play', () => updateVideoPlayerIcons(true));
            v.addEventListener('pause', () => updateVideoPlayerIcons(false));
            v.addEventListener('ended', () => {
                if (videoLoop) { v.currentTime = 0; v.play(); }
                else updateVideoPlayerIcons(false);
            });
        }

        function ensureVideoWaveSurfer() {
            const container = document.getElementById('videoWaveformContainer');
            const v = document.getElementById('studioVideoPlayer');
            if (!container || !v) return null;
            if (videoWaveSurfer) return videoWaveSurfer;
            if (typeof window.WaveSurfer === 'undefined') return null;

            try {
                const ctx = document.createElement('canvas').getContext('2d');
                const waveGrad = ctx.createLinearGradient(0, 0, 0, 60);
                waveGrad.addColorStop(0, '#22d3ee');
                waveGrad.addColorStop(0.5, '#7c5cff');
                waveGrad.addColorStop(1, '#a855f7');

                const progGrad = ctx.createLinearGradient(0, 0, 0, 60);
                progGrad.addColorStop(0, '#f472b6');
                progGrad.addColorStop(0.5, '#7c5cff');
                progGrad.addColorStop(1, '#22d3ee');

                videoWaveSurfer = WaveSurfer.create({
                    container: container,
                    media: v,
                    height: 54,
                    barWidth: 3,
                    barGap: 2,
                    barRadius: 3,
                    cursorWidth: 2,
                    cursorColor: '#f472b6',
                    waveColor: waveGrad,
                    progressColor: progGrad,
                    normalize: true,
                    interact: true
                });
                videoWaveSurfer.on('ready', () => {
                    document.getElementById('videoWaveformHint').classList.add('hidden');
                });
                return videoWaveSurfer;
            } catch (e) {
                return null;
            }
        }


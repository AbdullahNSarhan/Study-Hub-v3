                                <button onclick="renameFolder('${folderJs}')" title="Rename Folder" class="w-8 h-8 rounded-xl bg-white/80 dark:bg-gray-800 hover:bg-brand-500 hover:text-white text-gray-500 dark:text-gray-300 flex items-center justify-center transition shadow-sm">

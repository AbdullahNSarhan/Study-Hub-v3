                    faceDir: seat.faceDir,
                    waypoints: [],
                    emote: null,
                    emoteTimer: 80 + Math.floor(Math.random() * 140)
                });
            } else {
                zenDoorCurtainSway = 1.0;
                const waypoints = buildSanctuaryWaypoints(doorGx + 0.6, doorGy, seat.gx, seat.gy);
                zenSimGuests.push({
                    id: guestId,
                    gx: doorGx,
                    gy: doorGy,
                    seat,
                    outfit,
                    order,
                    state: 'ARRIVING',
                    beingServed: false,
                    timer: 0,
                    maxTimer: 720 + Math.floor(Math.random() * 380),
                    walkPhase: 0,
                    faceDir: 'SE',
                    waypoints,
                    emote: null,

        function updatePomo() {
            let m = Math.floor(pomoTime/60).toString().padStart(2,'0'), s = (pomoTime%60).toString().padStart(2,'0');
            const textStr = `${m}:${s}`;
            const disp = document.getElementById('pomoDisplay');
            if (disp) disp.textContent = textStr;
            const subReadout = document.getElementById('analogSubReadout');
            if (subReadout) subReadout.textContent = textStr;

            // Update Analog Clock Hands & Progress Arc
            const totalSecs = Math.max(1, (pomoMode === 'w' ? customWork : customBreak) * 60);
            const ratio = Math.max(0, Math.min(1, pomoTime / totalSecs));
            const circumference = 339.29;
            const arc = document.getElementById('analogProgressArc');
            if (arc) arc.style.strokeDashoffset = String(circumference * (1 - ratio));

            const minsFloat = (pomoTime % 3600) / 60;
            const secsPart = pomoTime % 60;
            const minAngle = (minsFloat / 60) * 360;
            const secAngle = (secsPart / 60) * 360;
            const minHand = document.getElementById('analogMinuteHand');
            const secHand = document.getElementById('analogSecondHand');
            if (minHand) minHand.setAttribute('transform', `rotate(${minAngle} 60 60)`);
            if (secHand) secHand.setAttribute('transform', `rotate(${secAngle} 60 60)`);
        }


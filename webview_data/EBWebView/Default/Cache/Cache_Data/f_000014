                darkGrad = 'linear-gradient(160deg, #090b1a 0%, #1e1b4b 50%, #020617 100%)';
            }
            document.documentElement.style.setProperty('--daydusk-bg', lightGrad);
            document.documentElement.style.setProperty('--daydusk-bg-dark', darkGrad);

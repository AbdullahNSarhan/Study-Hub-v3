        function playBeep() {
            if (state.settings && state.settings.notifications === false) return;
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const now = ctx.currentTime;
                [528, 660, 792].forEach((freq, i) => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(freq, now + i * 0.14);
                    gain.gain.setValueAtTime(0.18, now + i * 0.14);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.14 + 0.65);
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start(now + i * 0.14);
                    osc.stop(now + i * 0.14 + 0.7);
                });
            } catch(e) {}
        }

        function triggerTimerNotification(title, bodyText) {
            playBeep();
            showToast(`${title} — ${bodyText}`);
            if (state.settings && state.settings.notifications !== false && 'Notification' in window) {

    <script>
        // API Configurations
        const API_URL = '/api';
        const FILES_URL = '/files';

        // ---- Safety helpers ----
        const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
        // for values placed inside onclick="fn('...')": JS-escape first, then HTML-escape
        const escJs = s => esc(String(s ?? '').replace(/\\/g, '\\\\').replace(/'/g, "\\'"));
        // local date as YYYY-MM-DD (toISOString() is UTC and shifts the day after midnight in Egypt)
        const localDate = (d = new Date()) => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
        const defaultSettings = () => ({
            defaultSaveLocation: '',
            zenVideoFolder: '',
            bgTheme: 'aurora',
            particleEffect: 'network',
            clockStyle: 'digital',
            fontScale: 'medium',
            notifications: true,
            startup: false,
            perfThrottle: false,
            pomoWork: 25,
            pomoBreak: 5,
            mixerMaster: 80,
            mixerMuted: false,
            mixerLevels: {}
        });
        const emptyState = () => ({ subjects: [], pdfs: [], videos: [], recordings: [], notes: [], tasks: [], flashcards: [], whiteboards: [], deadlines: [], links: [], customSounds: [], settings: defaultSettings(), activity: {}, subjectTimes: {}, pomodorosCompleted: 0, pomodoroDays: {}, currentSubjectId: null });
        function normalizeState() {
            ['subjects','pdfs','videos','recordings','notes','tasks','flashcards','whiteboards','deadlines','links','customSounds'].forEach(k => { if(!Array.isArray(state[k])) state[k] = []; });
            ['activity','subjectTimes','pomodoroDays'].forEach(k => { if(!state[k] || typeof state[k] !== 'object') state[k] = {}; });
            state.settings = { ...defaultSettings(), ...(state.settings || {}) };

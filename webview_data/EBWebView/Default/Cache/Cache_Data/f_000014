        function updateDayDuskCssVars() {
            const h = new Date().getHours();
            let lightGrad, darkGrad;
            if (h >= 5 && h < 10) {
                lightGrad = 'linear-gradient(160deg, #fef3c7 0%, #fbcfe8 48%, #e0e7ff 100%)';
                darkGrad = 'linear-gradient(160deg, #311042 0%, #4c1d95 48%, #0f172a 100%)';
            } else if (h >= 10 && h < 17) {
                lightGrad = 'linear-gradient(160deg, #e0f2fe 0%, #f0f9ff 50%, #ede9fe 100%)';
                darkGrad = 'linear-gradient(160deg, #0c2d48 0%, #1e1b4b 55%, #090d16 100%)';
            } else if (h >= 17 && h < 20) {
                lightGrad = 'linear-gradient(160deg, #fed7aa 0%, #f9a8d4 48%, #c4b5fd 100%)';
                darkGrad = 'linear-gradient(160deg, #431407 0%, #3b0764 52%, #090b1a 100%)';
            } else {

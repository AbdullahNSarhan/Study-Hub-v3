        function seedGlobalParticles(mode, w, h) {
            globalParticleState.mode = mode;
            globalParticleState.items = [];
            globalParticleState.extra = [];
            if (mode === 'network') {
                const count = Math.min(75, Math.max(38, Math.floor((w * h) / 22000)));
                for (let i = 0; i < count; i++) {
                    globalParticleState.items.push({
                        x: Math.random() * w,
                        y: Math.random() * h,
                        vx: (Math.random() - 0.5) * 0.65,
                        vy: (Math.random() - 0.5) * 0.65,
                        r: Math.random() * 1.8 + 1.4,
                        pulse: Math.random() * Math.PI * 2
                    });
                }
            } else if (mode === 'cosmic') {
                const count = 110;
                const hues = [255, 195, 320, 42];
                for (let i = 0; i < count; i++) {
                    globalParticleState.items.push({
                        x: Math.random() * w,
                        y: Math.random() * h,
                        vx: (Math.random() - 0.5) * 0.22,
                        vy: -Math.random() * 0.28 - 0.05,
                        r: Math.random() * 2.4 + 0.6,
                        phase: Math.random() * Math.PI * 2,
                        speed: 0.02 + Math.random() * 0.04,
                        hue: hues[i % hues.length],
                        nebula: i < 16
                    });
                }
            } else if (mode === 'matrix') {
                const fontSize = 15;
                const cols = Math.ceil(w / fontSize);
                const chars = 'アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプ0123456789ABCDEF<>+=-*';
                for (let i = 0; i < cols; i++) {
                    globalParticleState.items.push({
                        x: i * fontSize,
                        y: Math.random() * -h,
                        speed: 1.6 + Math.random() * 2.8,
                        len: 8 + Math.floor(Math.random() * 14),
                        chars: Array.from({ length: 22 }, () => chars[Math.floor(Math.random() * chars.length)]),
                        tick: 0
                    });
                }
            } else if (mode === 'orbs') {
                const colors = [
                    [124, 92, 255], [34, 211, 238], [244, 114, 182], [167, 139, 250], [56, 189, 248]
                ];
                for (let i = 0; i < 20; i++) {
                    const rgb = colors[i % colors.length];
                    globalParticleState.items.push({
                        x: Math.random() * w,
                        y: Math.random() * h,
                        r: 36 + Math.random() * 75,
                        vx: (Math.random() - 0.5) * 0.4,
                        vy: (Math.random() - 0.5) * 0.4,
                        phase: Math.random() * Math.PI * 2,
                        rgb
                    });
                }
            } else if (mode === 'meteor') {
                // Static twinkling starfield + active shooting meteors
                for (let i = 0; i < 75; i++) {
                    globalParticleState.items.push({
                        x: Math.random() * w,
                        y: Math.random() * h,
                        r: Math.random() * 1.6 + 0.5,
                        phase: Math.random() * Math.PI * 2
                    });
                }
                for (let m = 0; m < 5; m++) {
                    globalParticleState.extra.push({
                        x: Math.random() * w * 1.3,
                        y: Math.random() * h * 0.5 - 100,
                        vx: -(4.5 + Math.random() * 4.5),
                        vy: 2.8 + Math.random() * 3.0,
                        len: 75 + Math.random() * 85,
                        size: 1.4 + Math.random() * 1.4,
                        delay: Math.random() * 90
                    });
                }
            }
        }

        function startOrStopGlobalThemeCanvas() {
            const c = document.getElementById('globalThemeCanvas');
            if (!c) return;
            const effect = state.settings?.particleEffect || 'network';
            if (effect === 'disable') {
                if (globalThemeAnimFrame) { cancelAnimationFrame(globalThemeAnimFrame); globalThemeAnimFrame = null; }
                const ctx = c.getContext('2d');
                ctx.clearRect(0, 0, c.width, c.height);
                return;
            }
            const ctx = c.getContext('2d');
            c.width = window.innerWidth;
            c.height = window.innerHeight;
            if (globalParticleState.mode !== effect || !globalParticleState.items.length) {
                seedGlobalParticles(effect, c.width, c.height);
            }
            if (globalThemeAnimFrame) cancelAnimationFrame(globalThemeAnimFrame);

            let tick = 0;
            function step() {
                const curEffect = state.settings?.particleEffect || 'network';
                if (curEffect === 'disable') return;
                if (globalParticleState.mode !== curEffect) {
                    seedGlobalParticles(curEffect, c.width, c.height);
                }
                tick++;
                if (!document.body.classList.contains('perf-throttled') && !document.body.classList.contains('zen-mode')) {
                    const w = c.width, h = c.height;
                    ctx.clearRect(0, 0, w, h);

                    if (curEffect === 'network') {
                        const nodes = globalParticleState.items;
                        const maxDist = 138;
                        const mx = globalParticleState.mouseX, my = globalParticleState.mouseY;
                        for (let i = 0; i < nodes.length; i++) {
                            const n = nodes[i];
                            n.x += n.vx; n.y += n.vy;
                            if (n.x < 0 || n.x > w) n.vx *= -1;
                            if (n.y < 0 || n.y > h) n.vy *= -1;

                            // Connect nearby nodes
                            for (let j = i + 1; j < nodes.length; j++) {
                                const n2 = nodes[j];
                                const dx = n.x - n2.x, dy = n.y - n2.y;
                                const dist = Math.hypot(dx, dy);
                                if (dist < maxDist) {
                                    const alpha = (1 - dist / maxDist) * (isDarkMode ? 0.28 : 0.22);
                                    ctx.strokeStyle = isDarkMode ? `rgba(124, 92, 255, ${alpha})` : `rgba(99, 102, 241, ${alpha})`;
                                    ctx.lineWidth = 1;
                                    ctx.beginPath();
                                    ctx.moveTo(n.x, n.y);
                                    ctx.lineTo(n2.x, n2.y);
                                    ctx.stroke();
                                }
                            }

                            // Interactive mouse tether
                            const mdx = n.x - mx, mdy = n.y - my;
                            const mDist = Math.hypot(mdx, mdy);
                            if (mDist < 175) {
                                const mAlpha = (1 - mDist / 175) * (isDarkMode ? 0.48 : 0.35);
                                ctx.strokeStyle = isDarkMode ? `rgba(34, 211, 238, ${mAlpha})` : `rgba(124, 92, 255, ${mAlpha})`;
                                ctx.lineWidth = 1.2;
                                ctx.beginPath();
                                ctx.moveTo(n.x, n.y);
                                ctx.lineTo(mx, my);
                                ctx.stroke();
                            }

                            ctx.fillStyle = isDarkMode ? 'rgba(165, 180, 252, 0.72)' : 'rgba(99, 102, 241, 0.58)';
                            ctx.beginPath();
                            ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
                            ctx.fill();
                        }
                    } else if (curEffect === 'cosmic') {
                        globalParticleState.items.forEach(p => {
                            p.x += p.vx; p.y += p.vy; p.phase += p.speed;
                            if (p.y < -20) p.y = h + 20;
                            if (p.x < -20) p.x = w + 20;
                            if (p.x > w + 20) p.x = -20;
                            const twinkle = 0.35 + 0.65 * Math.abs(Math.sin(p.phase));
                            if (p.nebula) {
                                const rad = p.r * 18;
                                const g = ctx.createRadialGradient(p.x, p.y, 1, p.x, p.y, rad);
                                g.addColorStop(0, `hsla(${p.hue}, 85%, 65%, ${isDarkMode ? 0.12 * twinkle : 0.08 * twinkle})`);
                                g.addColorStop(1, 'rgba(0,0,0,0)');
                                ctx.fillStyle = g;
                                ctx.beginPath(); ctx.arc(p.x, p.y, rad, 0, Math.PI * 2); ctx.fill();
                            } else {
                                ctx.fillStyle = `hsla(${p.hue}, 90%, ${isDarkMode ? '78%' : '55%'}, ${twinkle * (isDarkMode ? 0.8 : 0.55)})`;
                                ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fill();
                            }
                        });
                    } else if (curEffect === 'matrix') {
                        ctx.font = 'bold 14px monospace';
                        const chars = '0123456789ABCDEFアァカサタナハマヤラワ';
                        globalParticleState.items.forEach(col => {
                            col.y += col.speed;
                            col.tick++;
                            if (col.tick % 12 === 0) {
                                col.chars[Math.floor(Math.random() * col.chars.length)] = chars[Math.floor(Math.random() * chars.length)];
                            }
                            for (let k = 0; k < col.len; k++) {
                                const cy = col.y - k * 16;
                                if (cy < -20 || cy > h + 20) continue;
                                const ch = col.chars[k % col.chars.length];
                                if (k === 0) {
                                    ctx.fillStyle = isDarkMode ? 'rgba(167, 243, 208, 0.78)' : 'rgba(16, 185, 129, 0.65)';
                                } else {
                                    const fade = (1 - k / col.len) * (isDarkMode ? 0.34 : 0.24);
                                    ctx.fillStyle = isDarkMode ? `rgba(16, 185, 129, ${fade})` : `rgba(5, 150, 105, ${fade})`;
                                }
                                ctx.fillText(ch, col.x, cy);
                            }
                            if (col.y - col.len * 16 > h) {
                                col.y = Math.random() * -200;
                            }
                        });
                    } else if (curEffect === 'orbs') {
                        globalParticleState.items.forEach(o => {
                            o.x += o.vx; o.y += o.vy; o.phase += 0.015;
                            if (o.x < -o.r) o.x = w + o.r;
                            if (o.x > w + o.r) o.x = -o.r;
                            if (o.y < -o.r) o.y = h + o.r;
                            if (o.y > h + o.r) o.y = -o.r;
                            const pulse = 0.8 + 0.2 * Math.sin(o.phase);
                            const rad = o.r * pulse;
                            const g = ctx.createRadialGradient(o.x, o.y, rad * 0.05, o.x, o.y, rad);
                            const baseAlpha = isDarkMode ? 0.22 : 0.16;
                            g.addColorStop(0, `rgba(${o.rgb[0]}, ${o.rgb[1]}, ${o.rgb[2]}, ${baseAlpha})`);
                            g.addColorStop(0.6, `rgba(${o.rgb[0]}, ${o.rgb[1]}, ${o.rgb[2]}, ${baseAlpha * 0.4})`);
                            g.addColorStop(1, 'rgba(0,0,0,0)');
                            ctx.fillStyle = g;
                            ctx.beginPath(); ctx.arc(o.x, o.y, rad, 0, Math.PI * 2); ctx.fill();
                        });
                    } else if (curEffect === 'meteor') {
                        // Background twinkling stars
                        globalParticleState.items.forEach(st => {
                            st.phase += 0.03;
                            const a = (0.25 + 0.55 * Math.abs(Math.sin(st.phase))) * (isDarkMode ? 0.75 : 0.45);
                            ctx.fillStyle = isDarkMode ? `rgba(224, 231, 255, ${a})` : `rgba(99, 102, 241, ${a})`;
                            ctx.beginPath(); ctx.arc(st.x, st.y, st.r, 0, Math.PI * 2); ctx.fill();
                        });
                        // Shooting meteors
                        globalParticleState.extra.forEach(m => {
                            if (m.delay > 0) { m.delay--; return; }
                            m.x += m.vx; m.y += m.vy;
                            const tailX = m.x - m.vx * (m.len / 6);
                            const tailY = m.y - m.vy * (m.len / 6);
                            const g = ctx.createLinearGradient(m.x, m.y, tailX, tailY);
                            if (isDarkMode) {
                                g.addColorStop(0, 'rgba(254, 243, 199, 0.92)');
                                g.addColorStop(0.3, 'rgba(56, 189, 248, 0.48)');
                            } else {
                                g.addColorStop(0, 'rgba(124, 92, 255, 0.85)');
                                g.addColorStop(0.3, 'rgba(236, 72, 153, 0.42)');
                            }
                            g.addColorStop(1, 'rgba(0,0,0,0)');
                            ctx.strokeStyle = g;
                            ctx.lineWidth = m.size;
                            ctx.lineCap = 'round';
                            ctx.beginPath();
                            ctx.moveTo(m.x, m.y);
                            ctx.lineTo(tailX, tailY);
                            ctx.stroke();

                            // Glowing meteor head
                            ctx.fillStyle = isDarkMode ? 'rgba(255, 251, 235, 0.95)' : 'rgba(124, 92, 255, 0.9)';
                            ctx.beginPath(); ctx.arc(m.x, m.y, m.size * 1.3, 0, Math.PI * 2); ctx.fill();

                            if (m.x < -150 || m.y > h + 150) {
                                m.x = Math.random() * w * 1.2 + w * 0.2;
                                m.y = -40 - Math.random() * 120;
                                m.delay = 20 + Math.random() * 90;
                            }
                        });
                    }
                }
                globalThemeAnimFrame = requestAnimationFrame(step);
            }
            globalThemeAnimFrame = requestAnimationFrame(step);
        }

        // ================= MODULE 3: AMBIENT SOUND & WHITE NOISE MIXER =================
        const BUILTIN_SOUND_CHANNELS = [
            { id: 'zen_video', name: 'Zen Video / Sanctuary Audio', icon: 'fa-film text-amber-500', desc: 'Audio from active Zen video or sanctuary pad' },
            { id: 'rain', name: 'Gentle Rain', icon: 'fa-cloud-rain text-sky-400', desc: 'Soft rainfall & rooftop droplets' },
            { id: 'campfire', name: 'Campfire Hearth', icon: 'fa-fire text-orange-500', desc: 'Warm crackling fire & glowing embers' },
            { id: 'wind', name: 'Bamboo Forest Wind', icon: 'fa-wind text-emerald-400', desc: 'Breezy air sweeping through leaves' },
            { id: 'ocean', name: 'Ocean Waves', icon: 'fa-water text-cyan-500', desc: 'Rhythmic coastal tide & surf' },
            { id: 'crickets', name: 'Night Sanctuary', icon: 'fa-moon text-indigo-400', desc: 'Evening crickets & calm night air' },
            { id: 'brown_noise', name: 'Deep Brown Noise', icon: 'fa-wave-square text-purple-500', desc: 'Low-frequency focus masking' },
            { id: 'pink_noise', name: 'Soft Pink Noise', icon: 'fa-cloud text-pink-400', desc: 'Balanced acoustic background blanket' }
        ];

        let mixerAudioCtx = null;
        let mixerMasterGain = null;
        let activeSynthNodes = {};
        let activeCustomAudioEls = {};
        let previewAudioEl = null;
        let previewSoundId = null;

        function ensureMixerAudioCtx() {
            if (!mixerAudioCtx) {
                mixerAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
                mixerMasterGain = mixerAudioCtx.createGain();
                const masterVol = (state.settings?.mixerMuted) ? 0 : ((state.settings?.mixerMaster ?? 80) / 100);
                mixerMasterGain.gain.value = masterVol;
                mixerMasterGain.connect(mixerAudioCtx.destination);
            }
            if (mixerAudioCtx.state === 'suspended') {
                mixerAudioCtx.resume().catch(() => {});
            }
            return mixerAudioCtx;
        }

        function createProceduralChannelNode(ctx, channelId) {
            const outGain = ctx.createGain();
            outGain.gain.value = 0;
            outGain.connect(mixerMasterGain);
            const cleanupFns = [];

            if (channelId === 'zen_video') {
                // Warm harmonic sanctuary drone pad when built-in Zen scene is active (or blended)
                const freqs = [174.61, 261.63, 392.00]; // F3, C4, G4 warm fifths
                const padGain = ctx.createGain();
                padGain.gain.value = 0.14;
                padGain.connect(outGain);
                freqs.forEach((f, idx) => {
                    const osc = ctx.createOscillator();
                    const lfo = ctx.createOscillator();
                    const lfoGain = ctx.createGain();
                    osc.type = idx === 0 ? 'sine' : 'triangle';
                    osc.frequency.value = f;
                    lfo.frequency.value = 0.12 + idx * 0.05;
                    lfoGain.gain.value = 0.04;
                    const vGain = ctx.createGain();
                    vGain.gain.value = 0.12 / freqs.length;
                    lfo.connect(vGain.gain);
                    osc.connect(vGain);
                    vGain.connect(padGain);
                    osc.start(); lfo.start();
                    cleanupFns.push(() => { try { osc.stop(); lfo.stop(); } catch(e){} });
                });
                return { gainNode: outGain, stop: () => cleanupFns.forEach(fn => fn()) };
            }

            // Generate 4-second seamless noise buffer
            const bufLen = ctx.sampleRate * 4;
            const buffer = ctx.createBuffer(1, bufLen, ctx.sampleRate);
            const data = buffer.getChannelData(0);

            if (channelId === 'brown_noise' || channelId === 'ocean') {
                let last = 0;
                for (let i = 0; i < bufLen; i++) {
                    const w = Math.random() * 2 - 1;
                    data[i] = (last + 0.02 * w) / 1.02;
                    last = data[i];
                    data[i] *= 3.2;
                }
            } else if (channelId === 'pink_noise' || channelId === 'rain' || channelId === 'wind') {
                let b0=0, b1=0, b2=0, b3=0, b4=0, b5=0, b6=0;
                for (let i = 0; i < bufLen; i++) {
                    const w = Math.random() * 2 - 1;
                    b0 = 0.99886 * b0 + w * 0.0555179;
                    b1 = 0.99332 * b1 + w * 0.0750759;
                    b2 = 0.96900 * b2 + w * 0.1538520;
                    b3 = 0.86650 * b3 + w * 0.3104856;
                    b4 = 0.55000 * b4 + w * 0.5329522;
                    b5 = -0.7616 * b5 - w * 0.0168980;
                    data[i] = (b0 + b1 + b2 + b3 + b4 + b5 + b6 + w * 0.5362) * 0.04;
                    b6 = w * 0.115926;
                }
            } else if (channelId === 'campfire') {
                let last = 0;
                for (let i = 0; i < bufLen; i++) {
                    const w = Math.random() * 2 - 1;
                    last = (last + 0.03 * w) / 1.03;
                    // Add stochastic ember crackle pops
                    const pop = (Math.random() < 0.0018) ? (Math.random() * 1.9 - 0.95) : 0;
                    data[i] = last * 2.4 + pop * 0.65;
                }
            } else {
                for (let i = 0; i < bufLen; i++) data[i] = (Math.random() * 2 - 1) * 0.25;
            }

            const src = ctx.createBufferSource();
            src.buffer = buffer;
            src.loop = true;

            if (channelId === 'rain') {
                const filter = ctx.createBiquadFilter();
                filter.type = 'bandpass';
                filter.frequency.value = 1150;
                filter.Q.value = 0.65;
                src.connect(filter);
                filter.connect(outGain);
            } else if (channelId === 'wind') {
                const filter = ctx.createBiquadFilter();
                filter.type = 'bandpass';
                filter.frequency.value = 380;
                filter.Q.value = 2.8;
                const lfo = ctx.createOscillator();
                const lfoGain = ctx.createGain();
                lfo.frequency.value = 0.16;
                lfoGain.gain.value = 210;
                lfo.connect(filter.frequency);
                src.connect(filter);
                filter.connect(outGain);
                lfo.start();
                cleanupFns.push(() => { try { lfo.stop(); } catch(e){} });
            } else if (channelId === 'ocean') {
                const waveGain = ctx.createGain();
                waveGain.gain.value = 0.5;
                const lfo = ctx.createOscillator();
                const lfoDepth = ctx.createGain();
                lfo.frequency.value = 0.11; // ~9 second wave cycle
                lfoDepth.gain.value = 0.42;
                lfo.connect(waveGain.gain);
                src.connect(waveGain);
                waveGain.connect(outGain);
                lfo.start();
                cleanupFns.push(() => { try { lfo.stop(); } catch(e){} });
            } else if (channelId === 'crickets') {
                const hp = ctx.createBiquadFilter();
                hp.type = 'bandpass';
                hp.frequency.value = 4100;
                hp.Q.value = 8.0;
                const lfo = ctx.createOscillator();
                lfo.frequency.value = 3.8;
                const modGain = ctx.createGain();
                modGain.gain.value = 0.35;
                lfo.connect(modGain.gain);
                src.connect(hp);
                hp.connect(modGain);
                modGain.connect(outGain);
                lfo.start();
                cleanupFns.push(() => { try { lfo.stop(); } catch(e){} });
            } else {
                src.connect(outGain);
            }

            src.start();
            cleanupFns.push(() => { try { src.stop(); } catch(e){} });
            return { gainNode: outGain, stop: () => cleanupFns.forEach(fn => fn()) };
        }

        function syncZenVideoAudioChannel() {
            const vidEl = document.getElementById('zenBackdropVideo');
            const chVol = (state.settings?.mixerLevels?.zen_video || 0) / 100;
            const masterVol = (state.settings?.mixerMuted) ? 0 : ((state.settings?.mixerMaster ?? 80) / 100);
            const effectiveVol = Math.max(0, Math.min(1, chVol * masterVol));

            if (vidEl && zenUsingCustomVideo && !vidEl.classList.contains('hidden')) {
                vidEl.muted = (effectiveVol === 0);
                vidEl.volume = effectiveVol;
                // Silence procedural drone when real custom video audio is active
                if (activeSynthNodes['zen_video']) {
                    activeSynthNodes['zen_video'].gainNode.gain.value = 0;
                }
            } else {
                // Use warm sanctuary harmonic drone when built-in Zen scene is active
                if (chVol > 0) {
                    const ctx = ensureMixerAudioCtx();
                    if (!activeSynthNodes['zen_video']) {
                        activeSynthNodes['zen_video'] = createProceduralChannelNode(ctx, 'zen_video');
                    }
                    activeSynthNodes['zen_video'].gainNode.gain.setTargetAtTime(chVol * 0.65, ctx.currentTime, 0.08);
                } else if (activeSynthNodes['zen_video']) {
                    activeSynthNodes['zen_video'].gainNode.gain.value = 0;
                }
            }
        }

        function setMixerChannelVolume(channelId, val, skipSave = false) {
            const v = Math.max(0, Math.min(100, parseInt(val) || 0));
            state.settings.mixerLevels[channelId] = v;

            const lbl = document.getElementById(`mixerVolLabel-${channelId}`);
            if (lbl) lbl.textContent = `${v}%`;
            const slider = document.getElementById(`mixerSlider-${channelId}`);
            if (slider && parseInt(slider.value) !== v) slider.value = v;

            const isCustom = channelId.startsWith('custom_');
            if (channelId === 'zen_video') {
                syncZenVideoAudioChannel();
            } else if (isCustom) {
                const snd = (state.customSounds || []).find(s => s.id === channelId);
                if (snd) {
                    if (v > 0) {
                        if (!activeCustomAudioEls[channelId]) {
                            const a = new Audio(snd.url);
                            a.loop = true;
                            activeCustomAudioEls[channelId] = a;
                        }
                        const master = state.settings.mixerMuted ? 0 : ((state.settings.mixerMaster ?? 80) / 100);
                        activeCustomAudioEls[channelId].volume = Math.max(0, Math.min(1, (v / 100) * master));
                        if (activeCustomAudioEls[channelId].paused) {
                            activeCustomAudioEls[channelId].play().catch(() => {});
                        }
                    } else if (activeCustomAudioEls[channelId]) {
                        activeCustomAudioEls[channelId].pause();
                    }
                }
            } else {
                if (v > 0) {
                    const ctx = ensureMixerAudioCtx();
                    if (!activeSynthNodes[channelId]) {
                        activeSynthNodes[channelId] = createProceduralChannelNode(ctx, channelId);
                    }
                    activeSynthNodes[channelId].gainNode.gain.setTargetAtTime((v / 100) * 0.75, ctx.currentTime, 0.06);
                } else if (activeSynthNodes[channelId] && mixerAudioCtx) {
                    activeSynthNodes[channelId].gainNode.gain.setTargetAtTime(0, mixerAudioCtx.currentTime, 0.06);
                }
            }

            updateMixerStatusIndicators();
            if (!skipSave) saveData();
        }

        function setMixerMasterVolume(val) {
            const v = Math.max(0, Math.min(100, parseInt(val) || 0));
            state.settings.mixerMaster = v;
            if (v > 0 && state.settings.mixerMuted) state.settings.mixerMuted = false;
            document.getElementById('mixerMasterVolLabel').textContent = state.settings.mixerMuted ? 'Muted' : `${v}%`;
            applyMasterVolumeToAllActive();
            saveData();
        }

        function toggleMixerMasterMute() {
            state.settings.mixerMuted = !state.settings.mixerMuted;
            applyMasterVolumeToAllActive();
            saveData();
        }

        function applyMasterVolumeToAllActive() {
            const muted = !!state.settings.mixerMuted;
            const master = muted ? 0 : ((state.settings.mixerMaster ?? 80) / 100);
            if (mixerMasterGain && mixerAudioCtx) {
                mixerMasterGain.gain.setTargetAtTime(master, mixerAudioCtx.currentTime, 0.05);
            }
            Object.keys(activeCustomAudioEls).forEach(cid => {
                const chVol = (state.settings.mixerLevels[cid] || 0) / 100;
                activeCustomAudioEls[cid].volume = Math.max(0, Math.min(1, chVol * master));
            });
            syncZenVideoAudioChannel();

            const btn = document.getElementById('mixerMasterMuteBtn');
            const icon = document.getElementById('mixerMasterMuteIcon');
            const lbl = document.getElementById('mixerMasterVolLabel');
            if (btn) btn.className = muted ? 'w-9 h-9 rounded-xl bg-rose-500 text-white flex items-center justify-center shadow-sm transition shrink-0' : 'w-9 h-9 rounded-xl bg-brand-500 text-white flex items-center justify-center shadow-sm transition shrink-0';
            if (icon) icon.className = muted ? 'fa-solid fa-volume-xmark text-sm' : 'fa-solid fa-volume-high text-sm';
            if (lbl) lbl.textContent = muted ? 'Muted' : `${state.settings.mixerMaster ?? 80}%`;
            updateMixerStatusIndicators();
        }

        function resetAllMixerTracks() {
            Object.keys(state.settings.mixerLevels || {}).forEach(k => {
                setMixerChannelVolume(k, 0, true);
            });
            renderMixerChannels();
            saveData();
            showToast('All sound channels reset to 0%');
        }

        function applySoundPreset(preset) {
            Object.keys(state.settings.mixerLevels || {}).forEach(k => setMixerChannelVolume(k, 0, true));
            if (preset === 'rainy_zen') {
                setMixerChannelVolume('rain', 65, true);
                setMixerChannelVolume('zen_video', 35, true);
            } else if (preset === 'cozy_hearth') {
                setMixerChannelVolume('campfire', 70, true);
                setMixerChannelVolume('rain', 30, true);
                setMixerChannelVolume('wind', 20, true);
            } else if (preset === 'sanctuary') {
                setMixerChannelVolume('zen_video', 55, true);
                setMixerChannelVolume('wind', 35, true);
                setMixerChannelVolume('crickets', 25, true);
            } else if (preset === 'deep_brown') {
                setMixerChannelVolume('brown_noise', 65, true);
                setMixerChannelVolume('ocean', 25, true);
            }
            renderMixerChannels();
            saveData();
            showToast('Ambient mix preset applied 🎧');
        }

        function updateMixerStatusIndicators() {
            const levels = state.settings?.mixerLevels || {};
            const activeCount = Object.values(levels).filter(v => v > 0).length;
            const isPlaying = activeCount > 0 && !state.settings?.mixerMuted && (state.settings?.mixerMaster ?? 80) > 0;

            const badge = document.getElementById('mixerActiveCountBadge');
            if (badge) {
                badge.textContent = `${activeCount} active`;
                badge.classList.toggle('hidden', activeCount === 0);
            }
            document.getElementById('navMixerActiveDot')?.classList.toggle('hidden', !isPlaying);
            document.getElementById('pomoMixerDot')?.classList.toggle('hidden', !isPlaying);
        }

        function renderMixerChannels() {
            const list = document.getElementById('mixerChannelsList');
            if (!list) return;
            const levels = state.settings?.mixerLevels || {};
            const allChannels = [
                ...BUILTIN_SOUND_CHANNELS,
                ...(state.customSounds || []).map(s => ({
                    id: s.id,
                    name: s.name,
                    icon: 'fa-file-audio text-brand-400',
                    desc: 'Custom Imported White Noise'
                }))
            ];

            list.innerHTML = allChannels.map(ch => {
                const val = levels[ch.id] || 0;
                return `

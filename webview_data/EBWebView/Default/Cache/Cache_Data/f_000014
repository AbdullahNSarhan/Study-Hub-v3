        function renderConverterQueue() {
            const list = document.getElementById('converterQueueList');
            if (!list) return;
            if (converterQueue.length === 0) {
                list.innerHTML = `<div class="py-6 text-center text-xs font-bold text-gray-400">No files in queue yet — drop Word, Excel, PowerPoint, or Image files above.</div>`;
                return;
            }
            list.innerHTML = converterQueue.map(item => {
                const badge = getConverterFileBadge(item.name);
                let statusHtml = '';
                if (item.status === 'queued') {
                    statusHtml = `<span class="px-2.5 py-1 rounded-lg bg-gray-100 dark:bg-gray-700 text-gray-500 text-[11px] font-bold">Queued</span>
                        <button onclick="removeConverterQueueItem('${escJs(item.id)}')" class="w-7 h-7 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-900/30 text-gray-400 hover:text-rose-500 flex items-center justify-center"><i class="fa-solid fa-trash text-xs"></i></button>`;
                } else if (item.status === 'converting') {
                    statusHtml = `<span class="px-2.5 py-1 rounded-lg bg-brand-50 dark:bg-brand-500/20 text-brand-600 dark:text-brand-300 text-[11px] font-bold flex items-center gap-1.5"><i class="fa-solid fa-spinner fa-spin"></i> Converting...</span>`;
                } else if (item.status === 'done') {
                    statusHtml = `<span class="px-2.5 py-1 rounded-lg bg-emerald-50 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-300 text-[11px] font-bold"><i class="fa-solid fa-check mr-1"></i>PDF Ready</span>
                        <button onclick="openLocalPath('${escJs(item.outputPath)}')" class="px-2.5 py-1 rounded-lg bg-brand-600 hover:bg-brand-700 text-white text-[11px] font-bold shadow-sm transition">Open PDF</button>`;
                } else {
                    statusHtml = `<span class="px-2.5 py-1 rounded-lg bg-rose-50 dark:bg-rose-500/20 text-rose-600 dark:text-rose-300 text-[11px] font-bold" title="${esc(item.errorMsg || 'Failed')}"><i class="fa-solid fa-circle-exclamation mr-1"></i>Failed</span>`;
                }

                return `
                <div class="p-3 rounded-2xl bg-gray-50 dark:bg-gray-900/60 border border-gray-200/80 dark:border-gray-700 flex flex-col gap-2">
                    <div class="flex items-center justify-between gap-3">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-9 h-9 rounded-xl bg-white dark:bg-gray-800 flex items-center justify-center shadow-sm shrink-0">
                                <i class="fa-solid ${badge.icon} text-base"></i>
                            </div>
                            <div class="min-w-0">
                                <div class="text-xs sm:text-sm font-bold truncate text-gray-800 dark:text-gray-100">${esc(item.name)}</div>
                                <div class="text-[11px] text-gray-400 font-semibold">${badge.tag} • ${formatBytes(item.size)} ${item.pdfName ? `→ <span class="text-emerald-500 font-bold">${esc(item.pdfName)}</span>` : ''}</div>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">${statusHtml}</div>
                    </div>
                    <div class="w-full h-1.5 rounded-full bg-gray-200 dark:bg-gray-700 overflow-hidden">
                        <div class="h-full transition-all duration-300 ${item.status === 'error' ? 'bg-rose-500' : item.status === 'done' ? 'bg-emerald-500' : 'bg-brand-500'}" style="width:${item.progress}%"></div>
                    </div>
                </div>`;

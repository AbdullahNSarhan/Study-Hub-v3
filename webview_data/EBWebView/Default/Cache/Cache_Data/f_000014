        function stopCustomSoundPreview() {
            if (previewAudioEl) {
                previewAudioEl.pause();
                previewAudioEl = null;
            }
            previewSoundId = null;
        }

        function testListenCustomSound(id) {
            const snd = (state.customSounds || []).find(s => s.id === id);
            if (!snd) return;
            if (previewSoundId === id && previewAudioEl && !previewAudioEl.paused) {
                stopCustomSoundPreview();
                renderCustomSoundsLibrary();
                return;
            }
            stopCustomSoundPreview();
            previewSoundId = id;
            previewAudioEl = new Audio(snd.url);
            previewAudioEl.onended = () => { stopCustomSoundPreview(); renderCustomSoundsLibrary(); };
            previewAudioEl.play().catch(() => showToast('Could not preview audio', true));
            renderCustomSoundsLibrary();
        }

        function renameCustomSound(id) {
            const snd = (state.customSounds || []).find(s => s.id === id);
            if (!snd) return;
            requestInput('Rename Sound Track', snd.name, (newName) => {
                snd.name = newName;
                saveData();
                renderCustomSoundsLibrary();
                renderMixerChannels();
                showToast('Sound track renamed!');
            });
        }

        function deleteCustomSound(id) {
            const snd = (state.customSounds || []).find(s => s.id === id);
            if (!snd) return;
            requestConfirm(`Delete "${snd.name}" from your sound library?`, async () => {
                stopCustomSoundPreview();
                if (activeCustomAudioEls[id]) {
                    activeCustomAudioEls[id].pause();
                    delete activeCustomAudioEls[id];
                }
                delete state.settings.mixerLevels[id];
                state.customSounds = state.customSounds.filter(s => s.id !== id);
                try { await fetch(`${API_URL}/sounds/${encodeURIComponent(snd.filename)}`, { method: 'DELETE' }); } catch(e) {}
                saveData();
                renderCustomSoundsLibrary();
                renderMixerChannels();
                showToast('Custom sound deleted');
            });
        }


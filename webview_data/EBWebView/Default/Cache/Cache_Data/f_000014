            return true;
        }

        function stepActorAlongWaypoints(actor, speed) {
            if (!actor.waypoints || !actor.waypoints.length) return true;
            const target = actor.waypoints[0];
            const dx = target.gx - actor.gx;
            const dy = target.gy - actor.gy;
            const dist = Math.hypot(dx, dy);
            if (dist <= speed) {
                actor.gx = target.gx;
                actor.gy = target.gy;
                actor.waypoints.shift();
                return actor.waypoints.length === 0;
            }
            actor.gx += (dx / dist) * speed;
            actor.gy += (dy / dist) * speed;
            actor.walkPhase += 0.22;
            if (Math.abs(dx) > Math.abs(dy)) {
                actor.faceDir = dx > 0 ? 'SE' : 'NW';
            } else {
                actor.faceDir = dy > 0 ? 'SW' : 'NE';
            }
            return false;
        }

        function updateZenSanctuarySimulation() {
            if (zenDoorCurtainSway > 0) zenDoorCurtainSway = Math.max(0, zenDoorCurtainSway - 0.025);

            // Periodically spawn new guests in order at the entrance door
            zenSimSpawnCooldown--;
            if (zenSimSpawnCooldown <= 0) {
                if (zenSimGuests.length < 11) {
                    spawnZenSanctuaryGuest(false, false);
                }
                zenSimSpawnCooldown = 190 + Math.floor(Math.random() * 140);
            }

            // Update Koi fish swimming in ponds
            zenSimKoi.forEach(k => {
                k.phase += 0.16;
                k.gx += Math.cos(k.angle) * k.speed;
                k.gy += Math.sin(k.angle) * k.speed;
                if (k.gx < k.minX) { k.gx = k.minX; k.angle = Math.PI - k.angle + (Math.random() - 0.5) * 0.3; }
                if (k.gx > k.maxX) { k.gx = k.maxX; k.angle = Math.PI - k.angle + (Math.random() - 0.5) * 0.3; }
                if (k.gy < k.minY) { k.gy = k.minY; k.angle = -k.angle + (Math.random() - 0.5) * 0.3; }
                if (k.gy > k.maxY) { k.gy = k.maxY; k.angle = -k.angle + (Math.random() - 0.5) * 0.3; }
                k.angle += (Math.random() - 0.5) * 0.04;
            });

            // Update Guests state machine (ARRIVING -> ORDERING -> WAITING_FOOD -> ENJOYING -> LEAVING)
            for (let i = zenSimGuests.length - 1; i >= 0; i--) {
                const g = zenSimGuests[i];
                if (g.state === 'ARRIVING') {
                    if (stepActorAlongWaypoints(g, 0.038)) {
                        g.state = 'ORDERING';
                        g.faceDir = g.seat.faceDir;
                        g.timer = 75; // brief menu perusal before order ready for waiter
                    }
                } else if (g.state === 'ORDERING') {
                    g.timer--;
                    if (g.timer <= 0) {
                        g.state = 'WAITING_FOOD';
                    }
                } else if (g.state === 'WAITING_FOOD') {
                    // Waiter will transition guest to ENJOYING upon delivery; failsafe timeout after ~14s
                    g.timer++;
                    if (g.timer > 750) {
                        g.state = 'ENJOYING';
                        g.timer = g.maxTimer;
                    }
                } else if (g.state === 'ENJOYING') {
                    g.timer--;
                    g.emoteTimer--;
                    if (g.emoteTimer <= 0) {
                        const emotes = ['✨', '💡', '❤️', '🎵', '🍵'];
                        g.emote = emotes[Math.floor(Math.random() * emotes.length)];
                        g.emoteTimer = 180 + Math.floor(Math.random() * 160);
                    } else if (g.emoteTimer < 110) {
                        g.emote = null;
                    }
                    if (g.timer <= 0) {
                        // Finished studying/eating! Pay & walk out in order
                        zenSimCoins += g.order.reward;
                        zenSimLevelProgress += 0.04;
                        if (zenSimLevelProgress >= 1) { zenSimLevel++; zenSimLevelProgress -= 1; }
                        zenSimFloatTexts.push({
                            gx: g.gx, gy: g.gy, gz: 1.5,
                            text: `+¥${g.order.reward} ★`,
                            alpha: 1.0,
                            color: '#fde047'
                        });
                        if (g.seat) g.seat.occupiedBy = null;
                        g.state = 'LEAVING';
                        g.waypoints = buildSanctuaryWaypoints(g.gx, g.gy, 0.4, 4.2);
                    }
                } else if (g.state === 'LEAVING') {
                    if (stepActorAlongWaypoints(g, 0.04)) {
                        zenDoorCurtainSway = 1.0;
                        zenSimGuests.splice(i, 1);
                    }
                }
            }

            // Update Waiters / Staff state machine (IDLE -> TO_KITCHEN -> PICKING_UP -> TO_GUEST -> SERVING -> RETURN_HOME)
            zenSimWaiters.forEach(w => {
                if (w.state === 'IDLE') {
                    const waitingGuest = zenSimGuests.find(g => g.state === 'WAITING_FOOD' && !g.beingServed);
                    if (waitingGuest) {
                        waitingGuest.beingServed = true;
                        w.targetGuest = waitingGuest;
                        w.state = 'TO_KITCHEN';
                        w.waypoints = buildSanctuaryWaypoints(w.gx, w.gy, 5.8, 1.8);
                    }
                } else if (w.state === 'TO_KITCHEN') {
                    if (stepActorAlongWaypoints(w, 0.048)) {
                        w.state = 'PICKING_UP';
                        w.faceDir = 'NE';
                        w.timer = 28;
                    }
                } else if (w.state === 'PICKING_UP') {
                    w.timer--;
                    if (w.timer <= 0) {
                        if (!w.targetGuest || !zenSimGuests.includes(w.targetGuest)) {
                            w.state = 'IDLE';
                            w.targetGuest = null;
                        } else {
                            w.carryOrder = w.targetGuest.order;
                            w.state = 'TO_GUEST';
                            w.waypoints = buildSanctuaryWaypoints(w.gx, w.gy, w.targetGuest.gx, w.targetGuest.gy);
                        }
                    }
                } else if (w.state === 'TO_GUEST') {
                    if (!w.targetGuest || !zenSimGuests.includes(w.targetGuest)) {
                        w.carryOrder = null;
                        w.state = 'RETURN_HOME';
                        w.waypoints = buildSanctuaryWaypoints(w.gx, w.gy, w.homeGx, w.homeGy);
                    } else if (stepActorAlongWaypoints(w, 0.048)) {
                        w.targetGuest.state = 'ENJOYING';
                        w.targetGuest.timer = w.targetGuest.maxTimer;
                        w.targetGuest.beingServed = false;
                        w.carryOrder = null;
                        w.targetGuest = null;
                        w.state = 'RETURN_HOME';
                        w.waypoints = buildSanctuaryWaypoints(w.gx, w.gy, w.homeGx, w.homeGy);
                    }
                } else if (w.state === 'RETURN_HOME') {
                    // Check if another guest is waiting before going all the way home
                    const nextGuest = zenSimGuests.find(g => g.state === 'WAITING_FOOD' && !g.beingServed);
                    if (nextGuest) {
                        nextGuest.beingServed = true;
                        w.targetGuest = nextGuest;
                        w.state = 'TO_KITCHEN';
                        w.waypoints = buildSanctuaryWaypoints(w.gx, w.gy, 5.8, 1.8);
                    } else if (stepActorAlongWaypoints(w, 0.042)) {
                        w.state = 'IDLE';
                        w.faceDir = 'SW';
                    }
                }
            });

            // Update floating reward popups
            for (let i = zenSimFloatTexts.length - 1; i >= 0; i--) {
                const ft = zenSimFloatTexts[i];
                ft.gz += 0.025;
                ft.alpha -= 0.014;
                if (ft.alpha <= 0) zenSimFloatTexts.splice(i, 1);
            }
        }

        async function refreshZenVideosList(notify = false) {
            const folder = (state.settings?.zenVideoFolder || '').trim();
            const badgeEl = document.getElementById('zenFolderStatusBadge');
            const detailEl = document.getElementById('zenFolderDetectedText');

            try {
                const res = await fetch(`${API_URL}/zen_videos?folder=${encodeURIComponent(folder)}`);
                const data = await res.json();
                zenCustomVideos = Array.isArray(data.videos) ? data.videos : [];

                if (!folder) {
                    if (badgeEl) { badgeEl.textContent = 'Built-in Default'; badgeEl.className = 'px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-100 text-amber-700 dark:bg-amber-500/20 dark:text-amber-300 shrink-0'; }
                    if (detailEl) detailEl.innerHTML = `<i class="fa-solid fa-shield-heart text-emerald-500 mr-1.5"></i> Using built-in Isometric Zen Sanctuary simulation.`;
                } else if (!data.valid_folder || data.empty || zenCustomVideos.length === 0) {
                    if (badgeEl) { badgeEl.textContent = 'Fallback Active'; badgeEl.className = 'px-2.5 py-1 rounded-full text-[11px] font-bold bg-rose-100 text-rose-600 dark:bg-rose-500/20 dark:text-rose-300 shrink-0'; }
                    if (detailEl) detailEl.innerHTML = `<i class="fa-solid fa-circle-info text-amber-500 mr-1.5"></i> Custom folder is empty or missing — automatically running built-in Isometric Zen Sanctuary.`;
                    if (notify) showToast('Custom folder is empty/missing — fallback to default Zen Sanctuary active.');
                } else {
                    if (badgeEl) { badgeEl.textContent = `${zenCustomVideos.length} Video(s) Ready`; badgeEl.className = 'px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-300 shrink-0'; }
                    if (detailEl) detailEl.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-500 mr-1.5"></i> Loaded ${zenCustomVideos.length} custom video/animation file(s) from folder.`;
                    if (notify) showToast(`Loaded ${zenCustomVideos.length} custom Zen video(s)! 🎬`);
                }
            } catch (e) {
                zenCustomVideos = [];
            }

            if (document.body.classList.contains('zen-mode')) {
                applyZenBackdropSource();
            }
        }

        function activateBuiltinZenFallback(reasonMsg = null) {
            zenUsingCustomVideo = false;
            const vidEl = document.getElementById('zenBackdropVideo');
            const imgEl = document.getElementById('zenBackdropCustomImg');
            const builtinEl = document.getElementById('zenBuiltinScene');
            if (vidEl) { vidEl.pause(); vidEl.removeAttribute('src'); vidEl.classList.add('hidden'); }
            if (imgEl) { imgEl.removeAttribute('src'); imgEl.classList.add('hidden'); }
            if (builtinEl) builtinEl.classList.remove('hidden');

            document.getElementById('zenPrevVideoBtn')?.classList.add('hidden');
            document.getElementById('zenNextVideoBtn')?.classList.add('hidden');
            document.getElementById('zenSceneCycleBtn')?.classList.remove('hidden');
            document.getElementById('zenInviteGuestBtn')?.classList.remove('hidden');

            const scene = ZEN_BUILTIN_SCENES[zenBuiltinSceneIdx] || ZEN_BUILTIN_SCENES[0];
            const badge = document.getElementById('zenSourceBadge');
            if (badge) badge.textContent = reasonMsg ? `${scene.badge} (Auto-Fallback)` : scene.badge;
            startZenAmbientCanvas();
            syncZenVideoAudioChannel();
        }

        function applyZenBackdropSource() {
            if (!zenCustomVideos || zenCustomVideos.length === 0) {
                activateBuiltinZenFallback(state.settings?.zenVideoFolder ? 'Folder Empty' : null);
                return;
            }

            zenCurrentVideoIdx = ((zenCurrentVideoIdx % zenCustomVideos.length) + zenCustomVideos.length) % zenCustomVideos.length;
            const item = zenCustomVideos[zenCurrentVideoIdx];
            if (!item || !item.url) {
                activateBuiltinZenFallback('Fallback');
                return;
            }

            zenUsingCustomVideo = true;
            const builtinEl = document.getElementById('zenBuiltinScene');
            const vidEl = document.getElementById('zenBackdropVideo');
            const imgEl = document.getElementById('zenBackdropCustomImg');
            const isImageAnim = ['.gif', '.webp'].includes((item.ext || '').toLowerCase());

            document.getElementById('zenSceneCycleBtn')?.classList.add('hidden');
            document.getElementById('zenInviteGuestBtn')?.classList.add('hidden');
            const showArrows = zenCustomVideos.length > 1;
            const prevBtn = document.getElementById('zenPrevVideoBtn'), nextBtn = document.getElementById('zenNextVideoBtn');
            if (prevBtn) { prevBtn.classList.toggle('hidden', !showArrows); prevBtn.classList.toggle('flex', showArrows); }
            if (nextBtn) { nextBtn.classList.toggle('hidden', !showArrows); nextBtn.classList.toggle('flex', showArrows); }

            const badge = document.getElementById('zenSourceBadge');
            if (badge) badge.textContent = `Custom Zen Backdrop (${zenCurrentVideoIdx + 1}/${zenCustomVideos.length}) • ${item.name}`;

            if (isImageAnim) {
                if (vidEl) { vidEl.pause(); vidEl.classList.add('hidden'); }
                if (builtinEl) builtinEl.classList.add('hidden');
                if (imgEl) {
                    imgEl.onerror = () => { refreshZenVideosList(); activateBuiltinZenFallback('File Missing'); };
                    imgEl.src = item.url;
                    imgEl.classList.remove('hidden');
                }
            } else {
                if (imgEl) imgEl.classList.add('hidden');
                if (builtinEl) builtinEl.classList.add('hidden');
                if (vidEl) {
                    vidEl.onerror = () => { refreshZenVideosList(); activateBuiltinZenFallback('Video Unavailable'); };
                    vidEl.src = item.url;
                    vidEl.loop = true;
                    vidEl.classList.remove('hidden');
                    syncZenVideoAudioChannel();
                    vidEl.play().catch(() => {
                        vidEl.muted = true;
                        vidEl.play().catch(() => activateBuiltinZenFallback('Playback Fallback'));
                    });
                }
            }
        }

        function cycleZenCustomVideo(delta) {
            if (!zenCustomVideos.length) return;
            zenCurrentVideoIdx = (zenCurrentVideoIdx + delta + zenCustomVideos.length) % zenCustomVideos.length;
            applyZenBackdropSource();
        }

        function cycleBuiltinZenScene() {
            zenBuiltinSceneIdx = (zenBuiltinSceneIdx + 1) % ZEN_BUILTIN_SCENES.length;

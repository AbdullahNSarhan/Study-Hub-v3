    <style>
        :root { --accent: #7c5cff; --accent-2: #22d3ee; --accent-3: #f472b6; }
        html { color-scheme: light; }
        html.dark { color-scheme: dark; }
        body { font-family: 'Plus Jakarta Sans', 'Inter', 'Segoe UI', sans-serif; transition: background-color 0.3s, color 0.3s; user-select: none; -webkit-font-smoothing: antialiased; }
        input, textarea, select, [contenteditable] { user-select: text; }

        /* ---------- Aurora background ---------- */
        body::before {
            content: ''; position: fixed; inset: 0; z-index: -1; pointer-events: none;
            background:
                radial-gradient(900px 600px at 0% 0%, rgba(124,92,255,.14), transparent 60%),
                radial-gradient(800px 600px at 100% 0%, rgba(34,211,238,.12), transparent 60%),
                radial-gradient(900px 700px at 50% 110%, rgba(244,114,182,.10), transparent 60%),
                #f6f7fb;
        }
        .dark body::before {
            background:
                radial-gradient(900px 600px at 0% 0%, rgba(124,92,255,.22), transparent 60%),
                radial-gradient(800px 600px at 100% 0%, rgba(34,211,238,.12), transparent 60%),
                radial-gradient(900px 700px at 50% 110%, rgba(244,114,182,.12), transparent 60%),
                #090b1a;
        }
        body.bg-gray-50, .dark body.dark\:bg-gray-900 { background: transparent !important; }

        /* ---------- Glass surfaces ---------- */
        nav { background: rgba(255,255,255,.72) !important; backdrop-filter: blur(18px) saturate(160%); -webkit-backdrop-filter: blur(18px) saturate(160%); }
        .dark nav { background: rgba(17,20,42,.72) !important; border-color: rgba(255,255,255,.06) !important; }
        main .bg-white { background-color: rgba(255,255,255,.86); }
        #pomodoroWidget { background-color: rgba(255,255,255,.82); backdrop-filter: blur(14px); }
        .dark main .dark\:bg-gray-800 { background-color: rgba(26,30,53,.80) !important; }
        .dark #pomodoroWidget { background-color: rgba(26,30,53,.80) !important; backdrop-filter: blur(14px); }
        .dark .dark\:border-gray-700 { border-color: rgba(255,255,255,.07) !important; }
        .dark .dark\:border-gray-600 { border-color: rgba(255,255,255,.10) !important; }

        /* ---------- Gradient text & brand ---------- */
        .text-gradient { background: linear-gradient(90deg, #7c5cff, #22d3ee 55%, #f472b6); -webkit-background-clip: text; background-clip: text; color: transparent; }
        .brand-logo { background: linear-gradient(135deg, #7c5cff 0%, #a855f7 45%, #22d3ee 100%) !important; box-shadow: 0 8px 24px -6px rgba(124,92,255,.6); }

        /* ---------- Primary buttons glow (any bg-brand-600 / 500 button) ---------- */
        button.bg-brand-600, label.bg-brand-600, button.bg-brand-500 {
            background-image: linear-gradient(135deg, #7c5cff 0%, #9b5cff 50%, #6a3ff5 100%);
            box-shadow: 0 8px 22px -8px rgba(124,92,255,.75), inset 0 1px 0 rgba(255,255,255,.18);
            transition: transform .15s ease, box-shadow .2s ease, filter .2s ease;
        }
        button.bg-brand-600:hover, label.bg-brand-600:hover, button.bg-brand-500:hover { filter: brightness(1.08); transform: translateY(-1px); box-shadow: 0 12px 28px -8px rgba(124,92,255,.85); }
        button:active { transform: translateY(0) scale(.98); }
        button:focus-visible, a:focus-visible, label:focus-visible { outline: 2px solid #7c5cff; outline-offset: 2px; }
        input:focus, textarea:focus, select:focus { box-shadow: 0 0 0 4px rgba(124,92,255,.15); }

        /* ---------- Scrollbars ---------- */
        ::-webkit-scrollbar { width: 10px; height: 10px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #c8cddf; border-radius: 10px; border: 3px solid transparent; background-clip: content-box; }
        ::-webkit-scrollbar-thumb:hover { background: #9d82ff; background-clip: content-box; }
        .dark ::-webkit-scrollbar-thumb { background: #2c3150; background-clip: content-box; }
        .dark ::-webkit-scrollbar-thumb:hover { background: #6a3ff5; background-clip: content-box; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        
        .perspective-1000 { perspective: 1000px; }
        .transform-style-3d { transform-style: preserve-3d; transition: transform 0.6s cubic-bezier(.2,.8,.2,1); }
        .backface-hidden { backface-visibility: hidden; }
        .rotate-y-180 { transform: rotateY(180deg); }
        .is-flipped { transform: rotateY(180deg); }

        .confetti { position: fixed; width: 10px; height: 10px; z-index: 9999; border-radius: 2px; animation: fall 3s linear forwards; }
        @keyframes fall { to { transform: translateY(100vh) rotate(720deg); opacity: 0; } }

        /* ---------- Subject cards ---------- */
        .subject-card { position: relative; isolation: isolate; }
        .subject-card::after { content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px; background: linear-gradient(135deg, rgba(124,92,255,.0), rgba(124,92,255,.0)); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; transition: background .3s; pointer-events: none; z-index: -1; }
        .subject-card:hover::after { background: linear-gradient(135deg, #7c5cff, #22d3ee, #f472b6); }
        .subject-card:hover { box-shadow: 0 20px 40px -18px rgba(124,92,255,.45); }

        /* ---------- Folders ---------- */
        .pdf-folder { margin-bottom: 14px; background: rgba(255,255,255,.85); border-radius: 18px; border: 1px solid #e1e4ef; overflow: hidden; transition: 0.3s; }
        .dark .pdf-folder { background: rgba(26,30,53,.78); border-color: rgba(255,255,255,.07); }
        .folder-header { padding: 15px 20px; background: linear-gradient(90deg, rgba(124,92,255,.07), rgba(34,211,238,.04)); display: flex; justify-content: space-between; align-items: center; cursor: pointer; font-weight: 700; transition: 0.3s; }
        .dark .folder-header { background: linear-gradient(90deg, rgba(124,92,255,.14), rgba(34,211,238,.05)); color: #eef0f7; }
        .folder-header:hover { background: linear-gradient(90deg, rgba(124,92,255,.13), rgba(34,211,238,.07)); }
        .dark .folder-header:hover { background: linear-gradient(90deg, rgba(124,92,255,.22), rgba(34,211,238,.08)); }
        .folder-content { padding: 20px; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 15px; }
        .folder-content.hidden { display: none; }

        /* ---------- Tabs (segmented pill style) ---------- */
        .tab-btn { border-radius: 12px !important; border-bottom-width: 0 !important; }
        .tab-active { background: linear-gradient(135deg, #7c5cff, #6a3ff5) !important; color: #fff !important; box-shadow: 0 8px 20px -8px rgba(124,92,255,.8); }

        /* ---------- Toast ---------- */
        #toast { backdrop-filter: blur(10px); }

        /* ---------- Typography Scaling (Module 4) ---------- */
        html[data-font-scale="small"] { font-size: 14.25px; }
        html[data-font-scale="medium"] { font-size: 16px; }
        html[data-font-scale="large"] { font-size: 17.75px; }

        /* ---------- 5 Global Background Themes (Module 2 & 4) ---------- */
        @keyframes auroraShift {
            0%, 100% { filter: hue-rotate(0deg) saturate(110%); transform: scale(1); }
            50% { filter: hue-rotate(18deg) saturate(135%); transform: scale(1.04); }
        }
        body[data-bg-theme="aurora"]::before {
            animation: auroraShift 18s ease-in-out infinite;
        }
        body[data-bg-theme="particles"]::before {
            background:
                radial-gradient(1000px 700px at 15% 15%, rgba(124,92,255,.18), transparent 65%),
                radial-gradient(900px 650px at 85% 80%, rgba(34,211,238,.15), transparent 65%),
                #f4f6fc;
        }
        .dark body[data-bg-theme="particles"]::before {
            background:
                radial-gradient(1000px 700px at 15% 15%, rgba(124,92,255,.26), transparent 65%),
                radial-gradient(900px 650px at 85% 80%, rgba(34,211,238,.16), transparent 65%),
                #060814;
        }
        body[data-bg-theme="acrylic"]::before {
            background:
                linear-gradient(135deg, rgba(124,92,255,.20) 0%, rgba(34,211,238,.16) 50%, rgba(244,114,182,.18) 100%),
                #eef1f9;
        }
        .dark body[data-bg-theme="acrylic"]::before {
            background:
                linear-gradient(135deg, rgba(124,92,255,.28) 0%, rgba(15,23,42,.92) 52%, rgba(34,211,238,.20) 100%),
                #080b18;
        }
        body[data-bg-theme="acrylic"] main .bg-white,
        body[data-bg-theme="acrylic"] .pdf-folder {
            background-color: rgba(255,255,255,.64) !important;
            backdrop-filter: blur(26px) saturate(190%) !important;
            -webkit-backdrop-filter: blur(26px) saturate(190%) !important;
            box-shadow: 0 12px 32px -12px rgba(15,23,42,.12), inset 0 1px 0 rgba(255,255,255,.65) !important;
        }
        .dark body[data-bg-theme="acrylic"] main .dark\:bg-gray-800,
        .dark body[data-bg-theme="acrylic"] .pdf-folder {
            background-color: rgba(22,27,51,.58) !important;
            backdrop-filter: blur(26px) saturate(190%) !important;
            -webkit-backdrop-filter: blur(26px) saturate(190%) !important;
            box-shadow: 0 14px 36px -12px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.12) !important;
        }
        body[data-bg-theme="daydusk"]::before {
            background: var(--daydusk-bg, linear-gradient(165deg, #fde68a 0%, #fbcfe8 42%, #ddd6fe 100%)) !important;
            transition: background 1.2s ease;
        }
        .dark body[data-bg-theme="daydusk"]::before {
            background: var(--daydusk-bg-dark, linear-gradient(165deg, #1e1b4b 0%, #311042 48%, #090d16 100%)) !important;
            transition: background 1.2s ease;
        }
        body[data-bg-theme="minimal"]::before {
            background: #f8fafc !important;
            animation: none !important;
        }
        .dark body[data-bg-theme="minimal"]::before {
            background: #0b0f19 !important;
            animation: none !important;
        }
        body[data-bg-theme="minimal"] main .bg-white { background-color: #ffffff !important; backdrop-filter: none !important; }
        .dark body[data-bg-theme="minimal"] main .dark\:bg-gray-800 { background-color: #111827 !important; backdrop-filter: none !important; }

        /* Performance Throttle Mode */
        body.perf-throttled *, body.perf-throttled::before, body.perf-throttled::after {
            animation-play-state: paused !important;
        }

        /* ---------- Zen Mode & Visual Backdrops (Module 2) ---------- */
        body.zen-mode { overflow: hidden !important; }
        body.zen-mode nav, body.zen-mode #subjectModal, body.zen-mode #homeView, body.zen-mode .subject-header-top { display: none !important; }
        body.zen-mode #zenBackdropLayer { display: block !important; }
        body.zen-mode #subjectView.zen-workspace-visible {
            display: flex !important;
            position: fixed !important;
            inset: 68px 24px 24px 24px !important;
            height: auto !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 18px !important;
            z-index: 90 !important;
            background: rgba(15, 18, 34, 0.68) !important;
            backdrop-filter: blur(20px) saturate(160%) !important;
            border-radius: 28px !important;
            border: 1px solid rgba(255,255,255,0.14) !important;
            box-shadow: 0 25px 60px -15px rgba(0,0,0,0.65) !important;
        }
        body.zen-mode #subjectView:not(.zen-workspace-visible) {
            display: none !important;
        }

        /* Layout Safeguard: Floating Timer & Sound Mixer ALWAYS above Zen Video/Animation */
        #pomodoroWidget { z-index: 99990 !important; }
        #soundMixerDrawer { z-index: 99985 !important; }
        #zenTopBar { z-index: 99995 !important; transition: opacity 0.45s ease, transform 0.45s ease; }
        #breakModal { z-index: 99998 !important; }

        /* Zen Inactivity Auto-Hide Safeguards */
        body.zen-mode.zen-idle,
        body.zen-mode.zen-idle * {
            cursor: none !important;
        }
        body.zen-mode.zen-idle #zenTopBar,
        body.zen-mode.zen-idle .zen-autohide-el {
            opacity: 0 !important;
            transform: translateY(-10px) !important;
            pointer-events: none !important;
        }
        body.zen-mode.zen-idle #pomodoroWidget:not(:hover) {
            opacity: 0.78;
            transform: scale(0.97);
        }

        @keyframes kenBurnsSlow {
            0% { transform: scale(1.0) translate(0, 0); }
            50% { transform: scale(1.06) translate(-1.2%, -0.8%); }
            100% { transform: scale(1.0) translate(0, 0); }
        }
        .zen-ken-burns { animation: kenBurnsSlow 38s ease-in-out infinite; }

        /* [INJECTED] Image Zoom */
        #zoomableImage { transition: transform 0.2s ease-in-out; transform-origin: top left; }

        /* [INJECTED] Drag and Drop & Checkbox UI */
        .drag-over { border-color: #7c5cff !important; background-color: rgba(124, 92, 255, 0.06) !important; box-shadow: 0 0 0 2px rgba(124,92,255,.35) inset; }
        .file-checkbox { display: none; accent-color: #7c5cff; }
        .group:hover .file-checkbox, .file-checkbox:checked { display: block; }
        input[type=range], input[type=checkbox] { accent-color: #7c5cff; }

        /* Heatmap levels */
        .heat-0 { background: #e1e4ef; } .dark .heat-0 { background: #2c3150; }
        .heat-1 { background: #d9d0ff; } .heat-2 { background: #9d82ff; } .heat-3 { background: #6a3ff5; } .heat-4 { background: linear-gradient(135deg,#7c5cff,#22d3ee); }
        .dark .heat-1 { background: #3d2393; }

        @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
    </style>
</head>
<body data-bg-theme="aurora" class="bg-gray-50 text-gray-800 dark:bg-gray-900 dark:text-gray-100 min-h-screen flex flex-col relative overflow-x-hidden">


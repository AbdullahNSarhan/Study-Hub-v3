                        </button>
                        <button onclick="renameCustomSound('${escJs(s.id)}')" title="Rename" class="w-8 h-8 rounded-xl bg-gray-100 dark:bg-gray-700 hover:bg-brand-500 hover:text-white text-gray-500 flex items-center justify-center transition">
                            <i class="fa-solid fa-pen text-xs"></i>
                        </button>
                        <button onclick="deleteCustomSound('${escJs(s.id)}')" title="Delete" class="w-8 h-8 rounded-xl bg-rose-50 dark:bg-rose-900/30 hover:bg-rose-500 text-rose-500 hover:text-white flex items-center justify-center transition">
                            <i class="fa-solid fa-trash text-xs"></i>
                        </button>
                    </div>
                </div>`;
            }).join('');
        }

        // Interface & Display: Typography Scaling
        function setTypographyScale(scale, skipSave = false) {
            const valid = ['small', 'medium', 'large'].includes(scale) ? scale : 'medium';
            state.settings.fontScale = valid;
            document.documentElement.setAttribute('data-font-scale', valid);
            ['small', 'medium', 'large'].forEach(k => {
                const btn = document.getElementById(`fontScaleBtn-${k}`);
                if (btn) {
                    btn.className = (k === valid)
                        ? 'p-3 rounded-xl border-2 border-brand-500 bg-brand-50 dark:bg-brand-500/20 text-brand-600 dark:text-brand-300 font-bold text-xs flex flex-col items-center justify-center gap-1 transition shadow-sm'
                        : 'p-3 rounded-xl border-2 border-gray-200 dark:border-gray-700 hover:border-brand-300 text-gray-600 dark:text-gray-300 font-bold text-xs flex flex-col items-center justify-center gap-1 transition';
                }
            });
            if (!skipSave) saveData();
        }

        // System Utilities: Notifications, OS Boot Startup, Smart Performance Throttle
        let isOnBatteryPower = false;

        async function toggleSystemUtility(key, checked) {
            if (key === 'notifications') {
                state.settings.notifications = !!checked;
                if (checked && 'Notification' in window && Notification.permission === 'default') {
                    Notification.requestPermission().catch(() => {});
                }
                saveData();
                showToast(`Notification alerts ${checked ? 'enabled 🔔' : 'muted 🔕'}`);
            } else if (key === 'startup') {
                try {
                    const res = await fetch(`${API_URL}/startup`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ enabled: !!checked })
                    });
                    const data = await res.json();
                    state.settings.startup = !!data.enabled;
                    const chk = document.getElementById('settingStartupChk');
                    if (chk) chk.checked = state.settings.startup;
                    saveData();
                    showToast(state.settings.startup ? 'Enabled automatic launch on Windows boot 🚀' : 'Removed from Windows startup');
                } catch (e) {
                    showToast('Could not update startup setting', true);
                }
            } else if (key === 'perfThrottle') {
                state.settings.perfThrottle = !!checked;
                evaluatePerformanceThrottle();
                saveData();
                showToast(`Performance throttle ${checked ? 'enabled ⚡' : 'disabled'}`);
            }
        }

        function evaluatePerformanceThrottle() {
            const enabled = !!state.settings?.perfThrottle;
            const hidden = document.visibilityState === 'hidden';
            const shouldThrottle = enabled && (isOnBatteryPower || hidden || true);
            document.body.classList.toggle('perf-throttled', shouldThrottle);
        }

        function initBatteryAndPerformanceMonitor() {
            const badge = document.getElementById('batteryStatusBadge');
            if ('getBattery' in navigator) {
                navigator.getBattery().then(bat => {
                    const updateBat = () => {
                        isOnBatteryPower = !bat.charging;
                        const pct = Math.round((bat.level || 1) * 100);
                        if (badge) {
                            badge.textContent = bat.charging ? `⚡ Charging (${pct}%)` : `🔋 On Battery (${pct}%)`;
                            badge.className = bat.charging
                                ? 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-300'
                                : 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-700 dark:bg-amber-500/20 dark:text-amber-300';
                        }
                        evaluatePerformanceThrottle();
                    };
                    updateBat();
                    bat.addEventListener('chargingchange', updateBat);
                    bat.addEventListener('levelchange', updateBat);
                }).catch(() => {
                    if (badge) badge.textContent = 'AC / Desktop Power';
                });
            } else if (badge) {
                badge.textContent = 'AC / Desktop Power';
            }
        }

        // Data Management: Backup Export & Factory Reset
        async function exportData(saveToServerFolder = true) {
            if (saveToServerFolder) {
                try {
                    const res = await fetch(`${API_URL}/backup_export`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ state: state, save_dir: state.settings?.defaultSaveLocation || '' })
                    });
                    const data = await res.json();
                    if (res.ok && data.path) {
                        showToast(`Backup saved to ${data.filename}! 💾`);
                    }
                } catch (e) {}
            }
            const blob = new Blob([JSON.stringify(state, null, 2)], {type: 'application/json'});
            const url = URL.createObjectURL(blob); const a = document.createElement('a');
            a.href = url; a.download = `StudyHub_Backup_${new Date().toLocaleDateString('en-GB').replace(/\//g,'-')}.json`; a.click();
            setTimeout(() => URL.revokeObjectURL(url), 2000);
        }

        function openFactoryResetModal() {
            const modal = document.getElementById('factoryResetModal');
            document.getElementById('factoryResetConfirmInput').value = '';
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => document.getElementById('factoryResetConfirmInput').focus(), 80);
        }

        function closeFactoryResetModal() {
            const modal = document.getElementById('factoryResetModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        async function executeFactoryReset() {
            const val = (document.getElementById('factoryResetConfirmInput').value || '').trim().toUpperCase();
            if (val !== 'RESET') {
                return showToast('Please type RESET in the confirmation box to proceed.', true);
            }
            try {
                resetAllMixerTracks();
                const res = await fetch(`${API_URL}/factory_reset`, { method: 'POST' });
                if (!res.ok) throw new Error('Reset failed');
                state = emptyState();
                normalizeState();
                await flushSave();
                closeFactoryResetModal();
                closeSettingsModal();
                initAllModulesAndSettings();
                goToHome();
                renderHeatmap();
                showToast('Factory Reset complete — workspace wiped clean.');
            } catch (e) {
                showToast('Factory reset failed', true);
            }
        }

        async function initAllModulesAndSettings() {
            normalizeState();
            const s = state.settings;
            customWork = s.pomoWork || 25;
            customBreak = s.pomoBreak || 5;
            const wIn = document.getElementById('pomoWorkInput'); if (wIn) wIn.value = customWork;
            const bIn = document.getElementById('pomoBreakInput'); if (bIn) bIn.value = customBreak;
            if (!isPomo) { pomoTime = customWork * 60; }

            setTypographyScale(s.fontScale || 'medium', true);
            setTimerClockStyle(s.clockStyle || 'digital');
            setGlobalBgTheme(s.bgTheme || 'aurora');
            setParticleEffect(s.particleEffect || 'network', true);

            const masterSlider = document.getElementById('mixerMasterSlider');
            if (masterSlider) masterSlider.value = s.mixerMaster ?? 80;
            const masterLbl = document.getElementById('mixerMasterVolLabel');
            if (masterLbl) masterLbl.textContent = s.mixerMuted ? 'Muted' : `${s.mixerMaster ?? 80}%`;

            // Fetch system info (default export dir & Windows startup state)
            try {
                const res = await fetch(`${API_URL}/system_info`);
                if (res.ok) {
                    const info = await res.json();
                    if (info.defaultExportDir) systemDefaultExportDir = info.defaultExportDir;
                    s.startup = !!info.startupEnabled;
                }
            } catch (e) {}

            updateConverterTargetDirUI();
            refreshZenVideosList(false);
            renderMixerChannels();
            initBatteryAndPerformanceMonitor();
            evaluatePerformanceThrottle();

            // Bind Zen Mode mouse/key inactivity auto-hide safeguard
            ['mousemove', 'mousedown', 'keydown', 'wheel', 'touchstart'].forEach(ev => {
                window.addEventListener(ev, () => {
                    if (document.body.classList.contains('zen-mode')) resetZenIdleTimer();
                }, { passive: true });
            });
            window.addEventListener('resize', () => {
                const zc = document.getElementById('zenAmbientCanvas');
                if (zc) { zc.width = window.innerWidth; zc.height = window.innerHeight; }
                const gc = document.getElementById('globalThemeCanvas');
                if (gc) { gc.width = window.innerWidth; gc.height = window.innerHeight; }
            });
        }

        // ================= HEATMAP & SEARCH =================
        function renderHeatmap() {
            const grid = document.getElementById('heatmapGrid'); grid.innerHTML = '';
            let d = new Date(); d.setDate(d.getDate() - 29);
            for(let i=0; i<30; i++) {
                let dateStr = localDate(d), count = state.activity[dateStr] || 0;
                let cClass = count > 8 ? 'heat-4' : count > 5 ? 'heat-3' : count > 2 ? 'heat-2' : count > 0 ? 'heat-1' : 'heat-0';
                grid.innerHTML += `<div class="w-4 h-4 rounded-[5px] ${cClass} transition-all duration-300 hover:scale-125 hover:ring-2 ring-brand-400" title="${dateStr}: ${count} actions"></div>`;
                d.setDate(d.getDate() + 1);
            }
            updateFocusRing();
        }

        function updateFocusRing() {
            let pCount = (state.pomodoroDays || {})[localDate()] || 0;
            let ratio = Math.min((pCount / 4) * 100, 100);
            document.getElementById('focusRingPath').style.strokeDasharray = `${ratio}, 100`;
            document.getElementById('focusRingText').textContent = `${Math.round(ratio)}%`;
        }

        function initSearch() { document.addEventListener('keydown', (e) => {
            if(e.ctrlKey && e.key.toLowerCase() === 'k') { e.preventDefault(); openSearchModal(); }
            if(e.ctrlKey && e.key === ',') { e.preventDefault(); openSettingsModal(); }
            if(e.key === 'F11') { e.preventDefault(); toggleFullscreen(); }
            if(e.key === 'Escape' && !document.getElementById('factoryResetModal').classList.contains('hidden')) { closeFactoryResetModal(); return; }
            if(e.key === 'Escape' && !document.getElementById('settingsModal').classList.contains('hidden')) { closeSettingsModal(); return; }
            if(e.key === 'Escape' && !document.getElementById('pdfConverterModal').classList.contains('hidden')) { closePdfConverterModal(); return; }
            if(e.key === 'Escape' && !document.getElementById('soundMixerDrawer').classList.contains('hidden')) { toggleSoundMixer(); return; }
            if(e.key === 'Escape' && document.body.classList.contains('zen-mode')) { toggleZenMode(); return; }
            if(e.key === 'Escape') { closeSearchModal(); closeSubjectModal(); if(!document.getElementById('confirmModal').classList.contains('hidden')) closeConfirmModal(); }
        }); }
        function openSearchModal() { document.getElementById('searchModal').classList.remove('hidden'); setTimeout(()=>document.getElementById('searchInput').focus(), 100); }
        function closeSearchModal() { document.getElementById('searchModal').classList.add('hidden'); document.getElementById('searchInput').value=''; document.getElementById('searchResults').innerHTML=''; }
        function performSearch() {
            const q = document.getElementById('searchInput').value.toLowerCase().trim(), c = document.getElementById('searchResults');
            if(!q) { c.innerHTML = ''; return; }
            let r = [];
            state.notes.filter(n=>n.text.toLowerCase().includes(q)).forEach(n=>r.push({icon:'fa-pen text-yellow-500', t:'Note', text:n.text.substring(0,50)+'...', sub:n.subjectId, tab:'notes'}));
            (state.videos || []).filter(v=>v.title.toLowerCase().includes(q)).forEach(v=>r.push({icon:'fa-clapperboard text-cyan-500', t:'Video', text:v.title, sub:v.subjectId, tab:'videos', id:v.id}));
            (state.recordings || []).filter(rec=>rec.title.toLowerCase().includes(q)).forEach(rec=>r.push({icon:'fa-microphone-lines text-rose-500', t:'Recording', text:rec.title, sub:rec.subjectId, tab:'recordings', id:rec.id}));
            state.tasks.filter(t=>t.text.toLowerCase().includes(q)).forEach(t=>r.push({icon:'fa-check text-emerald-500', t:'Task', text:t.text, sub:t.subjectId, tab:'tasks'}));
            (state.links || []).filter(l=>l.title.toLowerCase().includes(q)).forEach(l=>r.push({icon:'fa-link text-blue-500', t:'Link', text:l.title, sub:l.subjectId, tab:'links'}));
            state.pdfs.filter(p=>p.original_name.toLowerCase().includes(q)).forEach(p=>r.push({icon:'fa-file text-blue-500', t:'File', text:p.original_name, sub:p.subjectId, tab:'pdfs'}));
            state.flashcards.filter(f=>f.q.toLowerCase().includes(q) || f.a.toLowerCase().includes(q)).forEach(f=>r.push({icon:'fa-clone text-purple-500', t:'Flashcard', text:f.q, sub:f.subjectId, tab:'flashcards'}));
            state.deadlines.filter(d=>d.title.toLowerCase().includes(q)).forEach(d=>r.push({icon:'fa-calendar text-brand-500', t:'Event', text:d.title, sub:d.subjectId, tab:'deadlines'}));
            
            c.innerHTML = r.length ? r.map(x => {
                const subName = state.subjects.find(s=>s.id === x.sub)?.name || 'Deleted Subject';
                return `
                <div onclick="openSearchResult('${escJs(x.sub)}', '${x.tab}', '${escJs(x.id || '')}')" class="p-3 border-b border-gray-100 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50 cursor-pointer flex justify-between rounded-xl mb-1 transition group">
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 rounded-lg bg-gray-100 dark:bg-gray-800 flex items-center justify-center shrink-0 shadow-inner"><i class="fa-solid ${x.icon} text-lg"></i></div>
                        <div>
                            <div class="text-sm font-bold text-gray-800 dark:text-gray-100">${esc(x.text)}</div>
                            <div class="text-xs font-semibold text-gray-500 mt-1">${esc(subName)} • ${x.t}</div>
                        </div>
                    </div>
                    <i class="fa-solid fa-arrow-right text-gray-300 opacity-0 group-hover:opacity-100 transition self-center"></i>
                </div>`
            }).join('') : '<div class="p-8 text-center text-gray-400 font-bold"><i class="fa-solid fa-ghost text-4xl mb-3"></i><br>No results found</div>';
        }
    </script>
</body>
</html>